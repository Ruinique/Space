# Copy this file to `.env` for local development (`.env` is gitignored).
# In CI / GitHub Pages, set these values via GitHub Actions Secrets/Variables.
# Note: `PUBLIC_*` variables are bundled into client-side JS; real security
# is enforced by Firebase Auth & `firestore.rules`, not by hiding client keys.

# Firebase Web App Configuration (find in Firebase Console -> Project Settings)
PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# Optional: Firebase App Check (reCAPTCHA Enterprise Site Key)
PUBLIC_FIREBASE_APPCHECK_KEY=""

# Admin Email for /admin and /tools UI guard (must match firestore.rules)
PUBLIC_ADMIN_EMAIL="admin@example.com"
