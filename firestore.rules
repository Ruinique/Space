rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ruiyizhan2003@gmail.com';
    }

    function isToggleDelta(newVal, oldVal) {
      return newVal is int
        && newVal >= 0
        && (newVal == oldVal + 1 || newVal == oldVal - 1);
    }

    // 文章与随笔的阅读量、可取消的 Emoji Reactions 统计
    match /posts_stats/{slug} {
      allow read: if true;

      // 首次创建：仅允许单个计数字段初始化为 1
      allow create: if request.resource.data.keys().hasOnly([
          'views', 'likes', 'r_like', 'r_fire', 'r_zap', 'r_tada', 'updatedAt'
        ])
        && (
          request.resource.data.get('views', 0) +
          request.resource.data.get('likes', 0) +
          request.resource.data.get('r_like', 0) +
          request.resource.data.get('r_fire', 0) +
          request.resource.data.get('r_zap', 0) +
          request.resource.data.get('r_tada', 0)
        ) == 1;

      // 更新：views 仅允许 +1；reactions 允许 +1 或 -1（且结果 >= 0）
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'views', 'likes', 'r_like', 'r_fire', 'r_zap', 'r_tada', 'updatedAt'
        ])
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasAny(['views'])
            && request.resource.data.views is int
            && request.resource.data.views == resource.data.get('views', 0) + 1)
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes'])
            && isToggleDelta(request.resource.data.likes, resource.data.get('likes', 0)))
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['r_like'])
            && isToggleDelta(request.resource.data.r_like, resource.data.get('r_like', 0)))
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['r_fire'])
            && isToggleDelta(request.resource.data.r_fire, resource.data.get('r_fire', 0)))
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['r_zap'])
            && isToggleDelta(request.resource.data.r_zap, resource.data.get('r_zap', 0)))
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['r_tada'])
            && isToggleDelta(request.resource.data.r_tada, resource.data.get('r_tada', 0)))
        );

      allow delete: if false;
    }

    // Telegram 群组讨论式实时评论区
    match /comments/{commentId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'slug', 'uid', 'authorName', 'authorPhoto', 'content', 'createdAt'
        ])
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 160
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.authorPhoto is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() < 500
        && request.resource.data.createdAt is timestamp;

      allow update: if false;

      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Telegram 频道研究随笔 (Moments)
    match /moments/{momentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 在线发布的长文 (Articles)
    match /articles/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 管理员私人工作箱配置（跨设备同步，仅管理员可读写）
    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
