---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Admin — Telegram Channel Composer"
  description="Static private Telegram-style channel composer and moderation panel"
  subtitle="Channel Management · Admin"
>
  <div class="max-w-3xl mx-auto px-4 py-6 space-y-5">
    <!-- Auth Status Card -->
    <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-[#2481cc]/15 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] flex items-center justify-center font-semibold text-sm">
          TG
        </div>
        <div>
          <div class="text-sm font-semibold text-slate-900 dark:text-[#f5f5f5]">
            Channel Composer
          </div>
          <div id="admin-user-label" class="text-xs text-[#6c7883]">
            Not signed in
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 text-xs">
        <button
          id="admin-google-btn"
          type="button"
          class="px-4 py-2 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium hover:opacity-90 transition-opacity cursor-pointer"
        >
          Sign in with Google
        </button>
        <button
          id="admin-logout-btn"
          type="button"
          class="hidden px-4 py-2 rounded-full bg-slate-100 dark:bg-white/10 text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          Sign Out
        </button>
      </div>
    </div>

    <!-- Locked State -->
    <div id="admin-locked" class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-6 text-center">
      <p id="admin-lock-msg" class="text-sm text-[#6c7883]">
        请使用管理员账号登录以解锁 Telegram 频道发布器、长文编辑器与评论管理面板。
      </p>
    </div>

    <!-- Authorized Workspace -->
    <div id="admin-workspace" class="hidden space-y-5">
      <!-- Telegram Segment Switcher -->
      <div class="inline-flex flex-wrap p-1 rounded-full bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] text-xs font-medium gap-1">
        <button
          id="tab-compose-btn"
          type="button"
          class="px-4 py-1.5 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] transition-colors cursor-pointer"
        >
          发短动态 (Moment)
        </button>
        <button
          id="tab-article-btn"
          type="button"
          class="px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          写长文 (Article)
        </button>
        <button
          id="tab-comments-btn"
          type="button"
          class="px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          管理评论 (Comments)
        </button>
      </div>

      <!-- Tab 1: Moment Composer -->
      <div id="panel-compose" class="space-y-4">
        <form
          id="moment-form"
          class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5 space-y-3"
        >
          <div class="flex items-center justify-between gap-2">
            <input
              id="moment-tag"
              type="text"
              value="RESEARCH"
              maxlength="24"
              placeholder="TAG"
              class="px-3 py-1 rounded-full bg-[#f1f4f8] dark:bg-[#0e1621] text-xs font-medium text-[#2481cc] dark:text-[#3ea6ff] focus:outline-none w-36"
            />
            <span id="moment-publish-status" class="text-xs text-[#6c7883]"></span>
          </div>

          <textarea
            id="moment-input"
            rows="4"
            placeholder="Broadcast a short note to /moments (Markdown & LaTeX supported)..."
            class="w-full rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 text-sm text-slate-900 dark:text-[#f5f5f5] placeholder:text-[#6c7883] focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
          ></textarea>

          <div
            id="moment-preview"
            class="prose prose-slate dark:prose-invert prose-tg max-w-none text-sm rounded-xl bg-[#f1f4f8]/60 dark:bg-[#0e1621]/50 p-3.5 min-h-14"
          >
            <span class="text-xs text-[#6c7883]">Live preview...</span>
          </div>

          <div class="flex items-center justify-end">
            <button
              type="submit"
              class="w-11 h-11 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] shadow-md hover:opacity-90 transition-opacity flex items-center justify-center cursor-pointer"
              aria-label="Broadcast Moment"
              title="Send"
            >
              <svg id="admin-plane-icon" class="w-5 h-5 translate-x-[-1px]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
              </svg>
            </button>
          </div>
        </form>

        <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4">
          <div class="text-xs font-semibold text-[#6c7883] mb-3">All Channel Moments</div>
          <div id="admin-moments-list" class="divide-y divide-slate-100 dark:divide-white/5"></div>
        </div>
      </div>

      <!-- Tab 2: Long-Form Article Editor -->
      <div id="panel-article" class="hidden space-y-4">
        <form
          id="article-form"
          class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5 space-y-3"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <input
              id="art-title"
              type="text"
              required
              placeholder="文章标题 (Title)"
              class="px-3.5 py-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] text-sm font-medium text-slate-900 dark:text-[#f5f5f5] placeholder:text-[#6c7883] focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
            />
            <input
              id="art-slug"
              type="text"
              required
              placeholder="URL Slug (e.g. cuda-warp-reduce)"
              class="px-3.5 py-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] text-sm font-mono text-slate-900 dark:text-[#f5f5f5] placeholder:text-[#6c7883] focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
            />
          </div>

          <input
            id="art-subtitle"
            type="text"
            placeholder="一句话摘要 / 副标题 (Subtitle / Abstract)"
            class="w-full px-3.5 py-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] text-sm text-slate-900 dark:text-[#f5f5f5] placeholder:text-[#6c7883] focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <input
              id="art-category"
              type="text"
              value="Systems"
              placeholder="分类 (Category)"
              class="px-3.5 py-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] text-xs text-slate-900 dark:text-[#f5f5f5] placeholder:text-[#6c7883] focus:outline-none"
            />
            <input
              id="art-tags"
              type="text"
              placeholder="标签，逗号分隔 (e.g. CUDA, HPC, Astro)"
              class="px-3.5 py-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] text-xs text-slate-900 dark:text-[#f5f5f5] placeholder:text-[#6c7883] focus:outline-none"
            />
          </div>

          <textarea
            id="art-content"
            rows="10"
            required
            placeholder="正文支持 Markdown、代码块与 LaTeX 公式（$...$ 或 $$...$$）..."
            class="w-full rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 font-mono text-xs leading-relaxed text-slate-900 dark:text-[#f5f5f5] placeholder:text-[#6c7883] focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
          ></textarea>

          <div
            id="art-preview"
            class="prose prose-slate dark:prose-invert prose-tg max-w-none text-sm rounded-xl bg-[#f1f4f8]/60 dark:bg-[#0e1621]/50 p-4 min-h-20"
          >
            <span class="text-xs text-[#6c7883]">Article live preview...</span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
            <span id="art-publish-status" class="text-xs text-[#6c7883]"></span>
            <div class="flex items-center gap-2">
              <button
                id="art-export-btn"
                type="button"
                class="px-3.5 py-2 rounded-full bg-slate-100 dark:bg-white/10 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-white/15 transition-colors cursor-pointer"
              >
                导出 .md
              </button>
              <button
                type="submit"
                class="px-5 py-2 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] text-xs font-semibold hover:opacity-90 transition-opacity cursor-pointer"
              >
                发布长文到频道
              </button>
            </div>
          </div>
        </form>

        <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4">
          <div class="text-xs font-semibold text-[#6c7883] mb-3">Published Online Articles</div>
          <div id="admin-articles-list" class="divide-y divide-slate-100 dark:divide-white/5"></div>
        </div>
      </div>

      <!-- Tab 3: Comments Moderation -->
      <div id="panel-comments" class="hidden rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4">
        <div class="text-xs font-semibold text-[#6c7883] mb-3">All Discussion Messages</div>
        <div id="admin-comments-list" class="divide-y divide-slate-100 dark:divide-white/5"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    db,
    isFirebaseConfigured,
    ADMIN_EMAIL,
    signInWithGoogle,
    signOutUser,
    onAuthChange,
  } from '../lib/firebase';
  import { renderAcademicMarkdown } from '../lib/markdown';
  import {
    collection,
    query,
    orderBy,
    onSnapshot,
    addDoc,
    setDoc,
    deleteDoc,
    doc,
    serverTimestamp,
  } from 'firebase/firestore';

  let unsubMoments: (() => void) | null = null;
  let unsubComments: (() => void) | null = null;
  let unsubArticles: (() => void) | null = null;

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function initAdmin() {
    unsubMoments?.();
    unsubComments?.();
    unsubArticles?.();
    unsubMoments = null;
    unsubComments = null;
    unsubArticles = null;

    const userLabel = document.getElementById('admin-user-label');
    const googleBtn = document.getElementById('admin-google-btn');
    const logoutBtn = document.getElementById('admin-logout-btn');
    const lockedEl = document.getElementById('admin-locked');
    const lockMsg = document.getElementById('admin-lock-msg');
    const workspaceEl = document.getElementById('admin-workspace');

    const tabComposeBtn = document.getElementById('tab-compose-btn');
    const tabArticleBtn = document.getElementById('tab-article-btn');
    const tabCommentsBtn = document.getElementById('tab-comments-btn');
    const panelCompose = document.getElementById('panel-compose');
    const panelArticle = document.getElementById('panel-article');
    const panelComments = document.getElementById('panel-comments');

    const momentForm = document.getElementById('moment-form') as HTMLFormElement | null;
    const momentTag = document.getElementById('moment-tag') as HTMLInputElement | null;
    const momentInput = document.getElementById('moment-input') as HTMLTextAreaElement | null;
    const momentPreview = document.getElementById('moment-preview');
    const publishStatus = document.getElementById('moment-publish-status');
    const planeIcon = document.getElementById('admin-plane-icon');
    const momentsListEl = document.getElementById('admin-moments-list');

    const artForm = document.getElementById('article-form') as HTMLFormElement | null;
    const artTitle = document.getElementById('art-title') as HTMLInputElement | null;
    const artSlug = document.getElementById('art-slug') as HTMLInputElement | null;
    const artSubtitle = document.getElementById('art-subtitle') as HTMLInputElement | null;
    const artCategory = document.getElementById('art-category') as HTMLInputElement | null;
    const artTags = document.getElementById('art-tags') as HTMLInputElement | null;
    const artContent = document.getElementById('art-content') as HTMLTextAreaElement | null;
    const artPreview = document.getElementById('art-preview');
    const artStatus = document.getElementById('art-publish-status');
    const artExportBtn = document.getElementById('art-export-btn');
    const articlesListEl = document.getElementById('admin-articles-list');

    const commentsListEl = document.getElementById('admin-comments-list');

    if (!workspaceEl) return;

    const activeCls = ['bg-[#2481cc]', 'dark:bg-[#3ea6ff]', 'text-white', 'dark:text-[#0e1621]'];
    const idleCls = ['text-[#6c7883]', 'hover:text-slate-900', 'dark:hover:text-white'];

    function switchTab(target: 'compose' | 'article' | 'comments') {
      const tabs = [
        { key: 'compose', btn: tabComposeBtn, panel: panelCompose },
        { key: 'article', btn: tabArticleBtn, panel: panelArticle },
        { key: 'comments', btn: tabCommentsBtn, panel: panelComments },
      ];
      tabs.forEach(({ key, btn, panel }) => {
        if (key === target) {
          panel?.classList.remove('hidden');
          btn?.classList.add(...activeCls);
          btn?.classList.remove(...idleCls);
        } else {
          panel?.classList.add('hidden');
          btn?.classList.remove(...activeCls);
          btn?.classList.add(...idleCls);
        }
      });
    }

    tabComposeBtn?.addEventListener('click', () => switchTab('compose'));
    tabArticleBtn?.addEventListener('click', () => switchTab('article'));
    tabCommentsBtn?.addEventListener('click', () => switchTab('comments'));

    const urlTab = new URLSearchParams(window.location.search).get('tab');
    if (urlTab === 'article') switchTab('article');
    else if (urlTab === 'comments') switchTab('comments');

    googleBtn?.addEventListener('click', () => signInWithGoogle().catch(console.error));
    logoutBtn?.addEventListener('click', () => signOutUser().catch(console.error));

    momentInput?.addEventListener('input', () => {
      if (!momentPreview) return;
      const val = momentInput.value.trim();
      momentPreview.innerHTML = val
        ? renderAcademicMarkdown(val)
        : '<span class="text-xs text-[#6c7883]">Live preview...</span>';
    });

    artTitle?.addEventListener('input', () => {
      if (artSlug && !artSlug.dataset.manual) {
        const slugified = artTitle.value
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-')
          .replace(/^-+|-+$/g, '');
        artSlug.value = slugified || `post-${Date.now()}`;
      }
    });
    artSlug?.addEventListener('input', () => {
      if (artSlug) artSlug.dataset.manual = '1';
    });

    artContent?.addEventListener('input', () => {
      if (!artPreview) return;
      const val = artContent.value.trim();
      artPreview.innerHTML = val
        ? renderAcademicMarkdown(val)
        : '<span class="text-xs text-[#6c7883]">Article live preview...</span>';
    });

    artExportBtn?.addEventListener('click', () => {
      const title = artTitle?.value.trim() || 'Untitled';
      const slug = artSlug?.value.trim() || 'untitled';
      const sub = artSubtitle?.value.trim() || '';
      const cat = artCategory?.value.trim() || 'Systems';
      const tags = (artTags?.value || '')
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean);
      const md = `---\ntitle: "${title.replace(/"/g, '\\"')}"\ndescription: "${sub.replace(/"/g, '\\"')}"\npubDate: ${new Date().toISOString().slice(0, 10)}\ncategory: "${cat}"\ntags: [${tags.map((t) => `"${t}"`).join(', ')}]\n---\n\n${artContent?.value || ''}\n`;
      const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${slug}.md`;
      a.click();
    });

    artForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!db || !artTitle || !artSlug || !artContent) return;
      const slug = artSlug.value.trim().replace(/\//g, '-');
      const title = artTitle.value.trim();
      const content = artContent.value.trim();
      if (!slug || !title || !content) return;

      if (artStatus) artStatus.textContent = 'Publishing...';
      try {
        const tags = (artTags?.value || '')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);
        await setDoc(doc(db, 'articles', slug), {
          title,
          subtitle: artSubtitle?.value.trim() || '',
          category: artCategory?.value.trim() || 'Systems',
          tags,
          content,
          createdAt: serverTimestamp(),
          updatedAt: serverTimestamp(),
        });
        if (artStatus) {
          artStatus.innerHTML = `Published! <a href="/read?slug=${encodeURIComponent(slug)}" class="underline text-[#2481cc]">View Article →</a>`;
        }
        artForm.reset();
        delete artSlug.dataset.manual;
        if (artPreview) artPreview.innerHTML = '<span class="text-xs text-[#6c7883]">Article live preview...</span>';
      } catch (err: any) {
        if (artStatus) artStatus.textContent = err?.message || 'Error';
      }
    });

    momentForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!db || !momentInput) return;
      const content = momentInput.value.trim();
      if (!content) return;

      if (planeIcon) {
        planeIcon.classList.remove('animate-tg-plane');
        void planeIcon.getBoundingClientRect();
        planeIcon.classList.add('animate-tg-plane');
      }

      if (publishStatus) publishStatus.textContent = 'Sending...';
      try {
        await addDoc(collection(db, 'moments'), {
          tag: (momentTag?.value || 'NOTE').trim().toUpperCase(),
          content,
          createdAt: serverTimestamp(),
        });
        momentInput.value = '';
        if (momentPreview) momentPreview.innerHTML = '<span class="text-xs text-[#6c7883]">Live preview...</span>';
        if (publishStatus) publishStatus.textContent = 'Sent ✓';
      } catch (err: any) {
        if (publishStatus) publishStatus.textContent = err?.message || 'Error';
      }
    });

    function subscribeAdminStreams() {
      if (!db) return;

      const momentsQ = query(collection(db, 'moments'), orderBy('createdAt', 'desc'));
      unsubMoments = onSnapshot(momentsQ, (snap) => {
        if (!momentsListEl) return;
        if (snap.empty) {
          momentsListEl.innerHTML = '<p class="py-4 text-xs text-[#6c7883]">No channel moments.</p>';
          return;
        }
        momentsListEl.innerHTML = snap.docs
          .map((d) => {
            const data = d.data();
            return `
              <div class="py-3 flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <span class="text-[11px] font-medium text-[#2481cc] dark:text-[#3ea6ff]">#${escapeHtml(data.tag || 'NOTE')}</span>
                  <p class="text-sm text-slate-800 dark:text-slate-200 truncate">${escapeHtml(data.content || '')}</p>
                </div>
                <button data-del-moment="${d.id}" class="text-xs text-red-500 hover:underline shrink-0 cursor-pointer">Delete</button>
              </div>
            `;
          })
          .join('');

        momentsListEl.querySelectorAll('[data-del-moment]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-del-moment');
            if (id && db) await deleteDoc(doc(db, 'moments', id));
          });
        });
      });

      const articlesQ = query(collection(db, 'articles'), orderBy('createdAt', 'desc'));
      unsubArticles = onSnapshot(articlesQ, (snap) => {
        if (!articlesListEl) return;
        if (snap.empty) {
          articlesListEl.innerHTML = '<p class="py-4 text-xs text-[#6c7883]">No online articles yet.</p>';
          return;
        }
        articlesListEl.innerHTML = snap.docs
          .map((d) => {
            const data = d.data();
            return `
              <div class="py-3 flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <a href="/read?slug=${encodeURIComponent(d.id)}" class="text-sm font-medium text-slate-800 dark:text-slate-200 hover:text-[#2481cc] truncate block">${escapeHtml(data.title || d.id)}</a>
                  <span class="text-[11px] text-[#6c7883] font-mono">/read?slug=${escapeHtml(d.id)}</span>
                </div>
                <button data-del-article="${d.id}" class="text-xs text-red-500 hover:underline shrink-0 cursor-pointer">Delete</button>
              </div>
            `;
          })
          .join('');

        articlesListEl.querySelectorAll('[data-del-article]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-del-article');
            if (id && db) await deleteDoc(doc(db, 'articles', id));
          });
        });
      });

      const commentsQ = query(collection(db, 'comments'), orderBy('createdAt', 'desc'));
      unsubComments = onSnapshot(commentsQ, (snap) => {
        if (!commentsListEl) return;
        if (snap.empty) {
          commentsListEl.innerHTML = '<p class="py-4 text-xs text-[#6c7883]">No discussion comments.</p>';
          return;
        }
        commentsListEl.innerHTML = snap.docs
          .map((d) => {
            const data = d.data();
            return `
              <div class="py-3 flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <div class="text-[11px] text-[#6c7883]">${escapeHtml(data.authorName || 'Reader')} · ${escapeHtml(data.slug || '')}</div>
                  <p class="text-sm text-slate-800 dark:text-slate-200 truncate">${escapeHtml(data.content || '')}</p>
                </div>
                <button data-del-comment="${d.id}" class="text-xs text-red-500 hover:underline shrink-0 cursor-pointer">Delete</button>
              </div>
            `;
          })
          .join('');

        commentsListEl.querySelectorAll('[data-del-comment]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-del-comment');
            if (id && db) await deleteDoc(doc(db, 'comments', id));
          });
        });
      });
    }

    if (!isFirebaseConfigured) {
      if (lockMsg) lockMsg.textContent = 'Firebase Web App configuration missing.';
      return;
    }

    onAuthChange((user) => {
      unsubMoments?.();
      unsubComments?.();
      unsubArticles?.();
      unsubMoments = null;
      unsubComments = null;
      unsubArticles = null;

      if (!user) {
        if (userLabel) userLabel.textContent = 'Not signed in';
        googleBtn?.classList.remove('hidden');
        logoutBtn?.classList.add('hidden');
        lockedEl?.classList.remove('hidden');
        workspaceEl?.classList.add('hidden');
        return;
      }

      if (userLabel) userLabel.textContent = user.email || user.uid;
      googleBtn?.classList.add('hidden');
      logoutBtn?.classList.remove('hidden');

      if (user.email === ADMIN_EMAIL) {
        lockedEl?.classList.add('hidden');
        workspaceEl?.classList.remove('hidden');
        subscribeAdminStreams();
      } else {
        lockedEl?.classList.remove('hidden');
        workspaceEl?.classList.add('hidden');
        if (lockMsg) lockMsg.textContent = `Access denied for ${user.email}.`;
      }
    });
  }

  initAdmin();
  document.addEventListener('astro:page-load', initAdmin);
</script>
