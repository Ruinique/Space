---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReactionPills from '../components/ReactionPills.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const artifacts = [
  {
    name: 'PPoPP27-BRDC-AE',
    tag: 'CUDA',
    desc: 'Revisiting Eigenvalue-Only Divide-and-Conquer Tridiagonal Eigensolver',
    url: 'https://github.com/Ruinique/PPoPP27-BRDC-AE',
  },
  {
    name: 'OpenBLAS',
    tag: 'HPC',
    desc: 'Optimized BLAS library & dense linear algebra kernels',
    url: 'https://github.com/Ruinique/OpenBLAS',
  },
  {
    name: 'sglang-omni',
    tag: 'Systems',
    desc: 'High-performance serving framework for audio & multimodal models',
    url: 'https://github.com/Ruinique/sglang-omni',
  },
];
---

<BaseLayout
  title="Ruiyi Zhan (@Ruinique) — Telegram Channel"
  subtitle={`${sortedPosts.length} posts · UESTC NDSL-HPC`}
>
  <div class="max-w-3xl mx-auto px-4 py-5 space-y-4">
    <!-- Telegram Pinned Channel Message -->
    <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5">
      <div class="flex items-center justify-between gap-2 mb-3">
        <div class="border-l-[3px] border-[#2481cc] dark:border-[#3ea6ff] pl-3">
          <div class="text-xs font-semibold text-[#2481cc] dark:text-[#3ea6ff]">
            Pinned Message
          </div>
          <div class="text-xs text-[#6c7883] truncate">
            Graduate Student @uestc-ndsl-hpc, School of Computer Science &amp; Engineering, UESTC
          </div>
        </div>
        <a
          href="https://github.com/Ruinique"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1 rounded-full text-xs font-medium bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:bg-[#2481cc]/20 transition-colors shrink-0"
        >
          @Ruinique ↗
        </a>
      </div>

      <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-200 mb-3">
        Researching numerical linear algebra, eigenvalue divide-and-conquer solvers, CUDA kernels, and LLM serving systems.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
        {
          artifacts.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block p-3 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621]/70 hover:bg-[#2481cc]/8 dark:hover:bg-[#3ea6ff]/12 transition-colors"
            >
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="text-xs font-semibold text-[#2481cc] dark:text-[#3ea6ff] truncate">
                  {item.name}
                </span>
                <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-white dark:bg-[#182533] text-[#6c7883]">
                  {item.tag}
                </span>
              </div>
              <p class="text-[11px] text-[#6c7883] line-clamp-2 leading-snug">
                {item.desc}
              </p>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Date Divider Pill -->
    <div class="flex items-center justify-between py-1 px-1">
      <span class="px-3 py-0.5 rounded-full text-xs font-medium bg-black/8 dark:bg-white/10 text-slate-700 dark:text-slate-200 backdrop-blur-md">
        Channel Feed
      </span>
      <a
        href="/admin?tab=article"
        class="px-3 py-1 rounded-full text-xs font-medium bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:bg-[#2481cc]/20 transition-colors"
      >
        + 写长文
      </a>
    </div>

    <!-- Online Published Articles from Firestore -->
    <div id="dynamic-articles-feed" class="space-y-4"></div>

    <!-- Channel Message Bubbles -->
    {
      sortedPosts.length === 0 ? (
        <div id="empty-channel-hint" class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-5">
          <div class="text-xs font-semibold text-[#2481cc] dark:text-[#3ea6ff] mb-1.5">
            Ruiyi Zhan
          </div>
          <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-200">
            频道已就绪。你可以点击右上角 <a href="/admin?tab=article" class="text-[#2481cc] dark:text-[#3ea6ff] font-medium hover:underline">+ 写长文</a> 在线发布长篇文章，或在 <a href="/moments" class="text-[#2481cc] dark:text-[#3ea6ff] hover:underline">/moments</a> 查看 Telegram 频道实时同步的动态。
          </p>
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <ReactionPills statId="channel-welcome" />
            <div class="flex items-center gap-1.5 text-[11px] text-[#6c7883] px-2 py-0.5 rounded-full bg-slate-100/80 dark:bg-white/5">
              <span>Channel Ready</span>
            </div>
          </div>
        </div>
      ) : (
        sortedPosts.map((post) => {
          const dateStr = post.data.pubDate.toISOString().slice(0, 10);
          return (
            <article
              transition:name={`card-${post.id}`}
              class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-5 hover:shadow-[0_4px_14px_rgba(0,0,0,0.07)] transition-shadow"
            >
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-semibold text-[#2481cc] dark:text-[#3ea6ff]">
                  Ruiyi Zhan · {post.data.category}
                </span>
                <div class="flex items-center gap-1.5">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="text-[11px] px-2 py-0.5 rounded-full bg-[#f1f4f8] dark:bg-white/8 text-[#6c7883]">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>

              <a href={`/posts/${post.id}`} class="block group">
                <h2
                  transition:name={`title-${post.id}`}
                  class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-[#f5f5f5] group-hover:text-[#2481cc] dark:group-hover:text-[#3ea6ff] transition-colors"
                >
                  {post.data.title}
                </h2>
                <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 mt-1.5">
                  {post.data.description}
                </p>
              </a>

              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                <ReactionPills statId={post.id} />

                <div class="flex items-center gap-2 text-[11px] text-[#6c7883] px-2.5 py-1 rounded-full bg-[#f1f4f8] dark:bg-white/8 tabular-nums">
                  <span class="inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                    <span data-view-slug={post.id}>—</span>
                  </span>
                  <span>·</span>
                  <span>{dateStr}</span>
                </div>
              </div>
            </article>
          );
        })
      )
    }
  </div>
</BaseLayout>

<script>
  import { db, isFirebaseConfigured } from '../lib/firebase';
  import { renderReactionPillsHtml, hydrateReactionContainer } from '../lib/reactions';
  import { doc, getDoc, collection, query, orderBy, getDocs } from 'firebase/firestore';

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function hydrateIndexViews() {
    if (!isFirebaseConfigured || !db) return;

    // Load online published articles from Firestore
    const feedEl = document.getElementById('dynamic-articles-feed');
    const emptyHint = document.getElementById('empty-channel-hint');
    if (feedEl) {
      try {
        const q = query(collection(db, 'articles'), orderBy('createdAt', 'desc'));
        const snap = await getDocs(q);
        if (!snap.empty) {
          emptyHint?.classList.add('hidden');
          feedEl.innerHTML = snap.docs
            .map((d) => {
              const data = d.data();
              const slug = d.id;
              const dt = data.createdAt?.toDate ? data.createdAt.toDate() : new Date();
              const pad = (n: number) => String(n).padStart(2, '0');
              const dateStr = `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
              const tags: string[] = Array.isArray(data.tags) ? data.tags : [];

              return `
                <article class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-5 hover:shadow-[0_4px_14px_rgba(0,0,0,0.07)] transition-shadow">
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-xs font-semibold text-[#2481cc] dark:text-[#3ea6ff]">
                      Ruiyi Zhan · ${escapeHtml(data.category || 'Essay')}
                    </span>
                    <div class="flex items-center gap-1.5">
                      ${tags
                        .slice(0, 3)
                        .map(
                          (t) =>
                            `<span class="text-[11px] px-2 py-0.5 rounded-full bg-[#f1f4f8] dark:bg-white/8 text-[#6c7883]">#${escapeHtml(t)}</span>`
                        )
                        .join('')}
                    </div>
                  </div>
                  <a href="/read?slug=${encodeURIComponent(slug)}" class="block group">
                    <h2 class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-[#f5f5f5] group-hover:text-[#2481cc] dark:group-hover:text-[#3ea6ff] transition-colors">
                      ${escapeHtml(data.title || 'Untitled')}
                    </h2>
                    ${
                      data.subtitle
                        ? `<p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 mt-1.5">${escapeHtml(data.subtitle)}</p>`
                        : ''
                    }
                  </a>
                  <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                    ${renderReactionPillsHtml(slug)}
                    <div class="flex items-center gap-2 text-[11px] text-[#6c7883] px-2.5 py-1 rounded-full bg-[#f1f4f8] dark:bg-white/8 tabular-nums">
                      <span>👁️ <span data-view-slug="${escapeHtml(slug)}">—</span></span>
                      <span>·</span>
                      <span>${dateStr}</span>
                    </div>
                  </div>
                </article>
              `;
            })
            .join('');

          feedEl.querySelectorAll<HTMLElement>('.tg-reactions').forEach((el) => {
            hydrateReactionContainer(el);
          });
        }
      } catch (err) {
        console.warn('[Index] Articles load skipped:', err);
      }
    }

    const nodes = document.querySelectorAll<HTMLElement>('[data-view-slug]');
    await Promise.all(
      Array.from(nodes).map(async (el) => {
        const slug = el.getAttribute('data-view-slug');
        if (!slug || !db) return;
        try {
          const snap = await getDoc(doc(db, 'posts_stats', slug));
          el.textContent = snap.exists() ? String(snap.data().views ?? 0) : '0';
        } catch {
          el.textContent = '0';
        }
      })
    );
  }

  hydrateIndexViews();
  document.addEventListener('astro:page-load', hydrateIndexViews);
</script>
