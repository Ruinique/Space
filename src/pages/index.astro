---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReactionPills from '../components/ReactionPills.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const researchAreas = [
  {
    icon: '🧮',
    title: 'Numerical Linear Algebra',
    tag: 'Algorithms',
    desc: 'Eigenvalue divide-and-conquer solvers, tridiagonal eigensolvers, and dense linear algebra kernels.',
  },
  {
    icon: '⚡',
    title: 'GPU & HPC Systems',
    tag: 'CUDA',
    desc: 'Warp-level primitives, memory hierarchy optimization, and high-throughput kernel engineering.',
  },
  {
    icon: '🚀',
    title: 'Training & Serving Systems',
    tag: 'AI Infra',
    desc: 'Distributed training frameworks (Kling AI training infra intern) and multimodal serving architectures.',
  },
];

const artifacts = [
  {
    name: 'PPoPP27-BRDC-AE',
    tag: 'CUDA',
    desc: 'Revisiting Eigenvalue-Only Divide-and-Conquer Tridiagonal Eigensolver',
    url: 'https://github.com/Ruinique/PPoPP27-BRDC-AE',
  },
  {
    name: 'LAPACK',
    tag: 'HPC',
    desc: 'LAPACK development repository & dense linear algebra routines',
    url: 'https://github.com/Ruinique/lapack',
  },
  {
    name: 'sglang-omni',
    tag: 'Systems',
    desc: 'High-performance serving framework for audio & multimodal models',
    url: 'https://github.com/Ruinique/sglang-omni',
  },
];

const toolkit = ['C / C++', 'CUDA', 'Python', 'PyTorch', 'Rust', 'CMake', 'Linux', 'Astro'];
---

<BaseLayout
  title="About — Ruiyi Zhan (@Ruinique)"
  description="Graduate Student @uestc-ndsl-hpc. Researching numerical linear algebra, CUDA kernels, and AI training & serving systems."
  subtitle="About · UESTC NDSL-HPC"
>
  <div class="max-w-3xl mx-auto px-4 py-5 space-y-4">
    <!-- Profile Hero Card -->
    <section class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-5 sm:p-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-3.5">
          <img
            src="https://avatars.githubusercontent.com/u/91458671?v=4"
            alt="Ruiyi Zhan"
            class="w-14 h-14 rounded-full object-cover ring-2 ring-[#2481cc]/20 dark:ring-[#3ea6ff]/25 shrink-0"
          />
          <div>
            <div class="flex items-center gap-1.5">
              <h1 class="text-lg font-bold text-slate-900 dark:text-[#f5f5f5]">Ruiyi Zhan</h1>
              <span class="text-xs font-mono text-[#6c7883]">@Ruinique</span>
            </div>
            <p data-i18n="about.role" class="text-xs text-[#6c7883] mt-0.5">
              Graduate Student @uestc-ndsl-hpc · School of CSE, UESTC
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a
            href="/blog"
            data-i18n="nav.blog"
            class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] hover:opacity-90 transition-opacity"
          >
            Blog
          </a>
          <a
            href="/moments"
            data-i18n="nav.moments"
            class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:bg-[#2481cc]/20 transition-colors"
          >
            Moments
          </a>
          <a
            href="https://github.com/Ruinique"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-full text-xs font-medium bg-[#f1f4f8] dark:bg-white/8 text-slate-700 dark:text-slate-200 hover:text-[#2481cc] dark:hover:text-[#3ea6ff] transition-colors"
          >
            GitHub ↗
          </a>
        </div>
      </div>

      <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-200">
        <span data-i18n="about.bioPrefix">Focused on </span><strong data-i18n="about.bio1" class="font-semibold text-slate-900 dark:text-white">numerical linear algebra</strong>,
        <strong data-i18n="about.bio2" class="font-semibold text-slate-900 dark:text-white">GPU kernel optimization</strong>,
        <strong data-i18n="about.bio3" class="font-semibold text-slate-900 dark:text-white">LLM serving systems</strong><span data-i18n="about.bioMid">. Sharing long-form technical notes in </span><a href="/blog" data-i18n="nav.blog" class="text-[#2481cc] dark:text-[#3ea6ff] hover:underline">Blog</a><span data-i18n="about.bioMid2"> and real-time lab fragments in </span><a href="/moments" data-i18n="nav.moments" class="text-[#2481cc] dark:text-[#3ea6ff] hover:underline">Moments</a><span data-i18n="about.bioSuffix">.</span>
      </p>

      <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
        <ReactionPills statId="about-profile" />
        <div class="flex items-center gap-2 text-[11px] text-[#6c7883] px-2.5 py-1 rounded-full bg-[#f1f4f8] dark:bg-white/8">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span data-i18n="about.location">Chengdu · NDSL-HPC</span>
        </div>
      </div>
    </section>

    <!-- Research Focus -->
    <section class="space-y-2.5">
      <div class="flex items-center justify-between px-1">
        <span data-i18n="about.researchTitle" class="px-3 py-0.5 rounded-full text-xs font-medium bg-black/8 dark:bg-white/10 text-slate-700 dark:text-slate-200">
          Research Focus
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {
          researchAreas.map((area, idx) => (
            <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-base">{area.icon}</span>
                <span data-i18n={`about.area${idx + 1}.tag`} class="text-[10px] px-2 py-0.5 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] font-medium">
                  {area.tag}
                </span>
              </div>
              <h2 data-i18n={`about.area${idx + 1}.title`} class="text-sm font-semibold text-slate-900 dark:text-[#f5f5f5] mb-1">
                {area.title}
              </h2>
              <p data-i18n={`about.area${idx + 1}.desc`} class="text-xs leading-relaxed text-[#6c7883]">
                {area.desc}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Pinned Projects / Artifacts -->
    <section class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5">
      <div class="flex items-center justify-between mb-3">
        <span data-i18n="about.pinnedTitle" class="text-xs font-semibold text-[#2481cc] dark:text-[#3ea6ff]">
          Pinned Projects
        </span>
        <a
          href="https://github.com/Ruinique?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="about.allRepos"
          class="text-[11px] text-[#6c7883] hover:text-[#2481cc] dark:hover:text-[#3ea6ff]"
        >
          All Repositories ↗
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        {
          artifacts.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block p-3.5 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621]/70 hover:bg-[#2481cc]/8 dark:hover:bg-[#3ea6ff]/12 transition-colors"
            >
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="text-xs font-semibold text-[#2481cc] dark:text-[#3ea6ff] truncate">
                  {item.name}
                </span>
                <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-white dark:bg-[#182533] text-[#6c7883]">
                  {item.tag}
                </span>
              </div>
              <p class="text-[11px] text-[#6c7883] line-clamp-2 leading-snug">
                {item.desc}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Toolkit & Recent Updates -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <section class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5">
        <div data-i18n="about.toolkit" class="text-xs font-semibold text-[#6c7883] mb-3">Toolkit</div>
        <div class="flex flex-wrap gap-1.5">
          {
            toolkit.map((item) => (
              <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-[#f1f4f8] dark:bg-[#0e1621] text-slate-700 dark:text-slate-200">
                {item}
              </span>
            ))
          }
        </div>
      </section>

      <section class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5">
        <div class="flex items-center justify-between mb-3">
          <span data-i18n="about.recentBlog" class="text-xs font-semibold text-[#6c7883]">Recent from Blog</span>
          <a href="/blog" data-i18n="about.viewAll" class="text-[11px] text-[#2481cc] dark:text-[#3ea6ff] hover:underline">
            View all →
          </a>
        </div>
        <div id="about-recent-blog" class="space-y-2.5">
          {
            recentPosts.length === 0 ? (
              <p id="about-recent-empty" class="text-xs text-[#6c7883]">Loading latest articles...</p>
            ) : (
              recentPosts.map((post) => (
                <a
                  href={`/posts/${post.id}`}
                  class="block rounded-xl bg-[#f1f4f8]/70 dark:bg-[#0e1621]/60 px-3 py-2 hover:bg-[#2481cc]/8 dark:hover:bg-[#3ea6ff]/12 transition-colors"
                >
                  <div class="text-xs font-semibold text-slate-900 dark:text-[#f5f5f5] truncate">
                    {post.data.title}
                  </div>
                  <div class="text-[11px] text-[#6c7883] mt-0.5">
                    {post.data.category} · {post.data.pubDate.toISOString().slice(0, 10)}
                  </div>
                </a>
              ))
            )
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { db, isFirebaseConfigured } from '../lib/firebase';
  import { collection, query, orderBy, limit, getDocs } from 'firebase/firestore';

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function hydrateAboutRecent() {
    if (!isFirebaseConfigured || !db) return;
    const container = document.getElementById('about-recent-blog');
    if (!container) return;

    try {
      const q = query(collection(db, 'articles'), orderBy('createdAt', 'desc'), limit(2));
      const snap = await getDocs(q);
      if (snap.empty) {
        const emptyEl = document.getElementById('about-recent-empty');
        if (emptyEl) emptyEl.textContent = 'No articles published yet.';
        return;
      }

      const onlineHtml = snap.docs
        .map((d) => {
          const data = d.data();
          const dt = data.createdAt?.toDate ? data.createdAt.toDate() : new Date();
          const pad = (n: number) => String(n).padStart(2, '0');
          const dateStr = `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
          return `
            <a
              href="/read?slug=${encodeURIComponent(d.id)}"
              class="block rounded-xl bg-[#f1f4f8]/70 dark:bg-[#0e1621]/60 px-3 py-2 hover:bg-[#2481cc]/8 dark:hover:bg-[#3ea6ff]/12 transition-colors"
            >
              <div class="text-xs font-semibold text-slate-900 dark:text-[#f5f5f5] truncate">
                ${escapeHtml(data.title || 'Untitled')}
              </div>
              <div class="text-[11px] text-[#6c7883] mt-0.5">
                ${escapeHtml(data.category || 'Essay')} · ${dateStr}
              </div>
            </a>
          `;
        })
        .join('');

      document.getElementById('about-recent-empty')?.remove();
      container.insertAdjacentHTML('afterbegin', onlineHtml);
    } catch {
      // ignore
    }
  }

  hydrateAboutRecent();
  document.addEventListener('astro:page-load', hydrateAboutRecent);
</script>
