---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Moments — Telegram Channel Stream"
  description="Real-time research notes and engineering fragments."
  subtitle="Live Moments · Real-Time Channel"
>
  <div class="max-w-3xl mx-auto px-4 py-5 space-y-4">
    <!-- Channel Status Pill -->
    <div class="flex items-center justify-between px-1">
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-black/8 dark:bg-white/10 text-slate-700 dark:text-slate-200 backdrop-blur-md">
        Lab Notes &amp; Fragments
      </span>
      <span id="moments-live-indicator" class="text-xs font-medium text-[#6c7883]">
        ● Connecting...
      </span>
    </div>

    <!-- Real-time Telegram Channel Bubbles -->
    <div id="moments-feed" class="space-y-4">
      <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-6 text-center text-xs text-[#6c7883]">
        Synchronizing messages...
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { db, isFirebaseConfigured } from '../lib/firebase';
  import { renderAcademicMarkdown } from '../lib/markdown';
  import { renderReactionPillsHtml, hydrateReactionContainer } from '../lib/reactions';
  import { collection, query, orderBy, onSnapshot } from 'firebase/firestore';

  let unsubscribeMoments: (() => void) | null = null;

  function initMomentsFeed() {
    unsubscribeMoments?.();
    unsubscribeMoments = null;

    const feedEl = document.getElementById('moments-feed');
    const indicatorEl = document.getElementById('moments-live-indicator');
    if (!feedEl) return;

    if (!isFirebaseConfigured || !db) {
      if (indicatorEl) indicatorEl.textContent = '○ Offline';
      feedEl.innerHTML =
        '<div class="rounded-2xl bg-white dark:bg-[#182533] p-6 text-center text-xs text-[#6c7883]">Firebase Web App configuration missing.</div>';
      return;
    }

    const seenIds = new Set<string>();
    const q = query(collection(db, 'moments'), orderBy('createdAt', 'desc'));

    unsubscribeMoments = onSnapshot(
      q,
      (snapshot) => {
        if (indicatorEl) {
          indicatorEl.innerHTML =
            `<span class="text-[#2481cc] dark:text-[#3ea6ff]">● Live</span> · ${snapshot.size} messages`;
        }

        if (snapshot.empty) {
          feedEl.innerHTML = `
            <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-6 text-center text-sm text-[#6c7883]">
              频道暂无动态。前往 <a href="/admin" class="text-[#2481cc] dark:text-[#3ea6ff] hover:underline">/admin</a> 发送第一条消息。
            </div>
          `;
          return;
        }

        feedEl.innerHTML = snapshot.docs
          .map((docSnap) => {
            const data = docSnap.data();
            const dt = data.createdAt?.toDate ? data.createdAt.toDate() : new Date();
            const pad = (n: number) => String(n).padStart(2, '0');
            const dateStr = `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
            const timeStr = `${pad(dt.getHours())}:${pad(dt.getMinutes())}`;
            const tag = data.tag || 'NOTE';
            const html = renderAcademicMarkdown(data.content || '');
            const isNew = !seenIds.has(docSnap.id);
            seenIds.add(docSnap.id);
            const tgLink =
              data.tgChannelUsername && data.tgMessageId
                ? `<a href="https://t.me/${data.tgChannelUsername}/${data.tgMessageId}" target="_blank" rel="noopener noreferrer" class="text-[#2481cc] dark:text-[#3ea6ff] hover:underline mr-1">Telegram ↗</a>`
                : '';

            return `
              <article class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-5 ${isNew ? 'animate-tg-bubble' : ''}">
                <div class="flex items-center justify-between gap-2 mb-2.5">
                  <span class="text-xs font-semibold text-[#2481cc] dark:text-[#3ea6ff]">
                    Ruiyi Zhan
                  </span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff]">
                    #${tag}
                  </span>
                </div>

                <div class="prose prose-slate dark:prose-invert prose-tg max-w-none text-[15px]">
                  ${html}
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/5 flex flex-wrap items-center justify-between gap-3">
                  ${renderReactionPillsHtml(`moment_${docSnap.id}`)}

                  <div class="flex items-center gap-1.5 text-[11px] text-[#6c7883] px-2.5 py-1 rounded-full bg-[#f1f4f8] dark:bg-white/8 tabular-nums">
                    ${tgLink}
                    <span>${dateStr} ${timeStr}</span>
                  </div>
                </div>
              </article>
            `;
          })
          .join('');

        feedEl.querySelectorAll<HTMLElement>('.tg-reactions').forEach((el) => {
          hydrateReactionContainer(el);
        });
      },
      (err) => {
        console.warn('[Moments] Error:', err);
        if (indicatorEl) indicatorEl.textContent = '○ Error';
      }
    );
  }

  initMomentsFeed();
  document.addEventListener('astro:page-load', initMomentsFeed);
</script>
