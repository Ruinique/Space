<script>
  import { doc, getDoc, serverTimestamp, setDoc } from 'firebase/firestore';
  import {
    ADMIN_EMAIL,
    auth,
    db,
    isFirebaseConfigured,
    onAuthChange,
    signInWithGoogle,
    signOutUser,
  } from '../lib/firebase';
  import { applyI18n, t } from '../lib/i18n';

  interface KomariConfig {
    baseUrl: string;
    apiPath: string;
    token: string;
    proxyUrl: string;
    mode: 'api' | 'iframe';
  }

  const STORAGE_KEY = 'space_komari_config_v1';
  let unsubscribeAuth: (() => void) | null = null;
  let refreshTimer: ReturnType<typeof setInterval> | null = null;

  function escapeHtml(str: unknown): string {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function loadConfig(): KomariConfig {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        return {
          baseUrl: typeof parsed.baseUrl === 'string' ? parsed.baseUrl : '',
          apiPath: typeof parsed.apiPath === 'string' && parsed.apiPath ? parsed.apiPath : '/api/nodes',
          token: typeof parsed.token === 'string' ? parsed.token : '',
          proxyUrl: typeof parsed.proxyUrl === 'string' ? parsed.proxyUrl : '',
          mode: parsed.mode === 'iframe' ? 'iframe' : 'api',
        };
      }
    } catch {
      // ignore invalid storage
    }
    return { baseUrl: '', apiPath: '/api/nodes', token: '', proxyUrl: '', mode: 'api' };
  }

  function saveConfig(cfg: KomariConfig): void {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg));
  }

  function formatBytes(bytes: number): string {
    if (!Number.isFinite(bytes) || bytes <= 0) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
    return `${(bytes / Math.pow(1024, i)).toFixed(1)} ${units[i]}`;
  }

  function formatUptime(sec: number): string {
    if (!Number.isFinite(sec) || sec <= 0) return '-';
    const d = Math.floor(sec / 86400);
    const h = Math.floor((sec % 86400) / 3600);
    const m = Math.floor((sec % 3600) / 60);
    if (d > 0) return `${d}d ${h}h`;
    if (h > 0) return `${h}h ${m}m`;
    return `${m}m`;
  }

  function normalizeNodes(payload: any): any[] {
    if (Array.isArray(payload)) return payload;
    if (payload && Array.isArray(payload.data)) return payload.data;
    if (payload && payload.data && Array.isArray(payload.data.nodes)) return payload.data.nodes;
    if (payload && Array.isArray(payload.nodes)) return payload.nodes;
    return [];
  }

  function renderNodes(nodes: any[]) {
    const grid = document.getElementById('komari-nodes-grid');
    if (!grid) return;

    if (!nodes.length) {
      grid.innerHTML = `
        <div class="sm:col-span-2 rounded-xl border border-dashed border-slate-200 dark:border-white/10 p-6 text-center text-xs text-[#6c7883]">
          接口返回成功，但暂无节点数据。
        </div>`;
      return;
    }

    grid.innerHTML = nodes
      .map((n) => {
        const name = escapeHtml(n.name || n.hostname || n.uuid || 'Unnamed Node');
        const region = escapeHtml(n.region || n.country || n.os || '');
        const latest = n._recent || null;
        const online =
          typeof n.online === 'boolean'
            ? n.online
            : latest !== null
              ? true
              : typeof n.status === 'string'
                ? n.status.toLowerCase() === 'online'
                : false;

        const cpuRaw = latest?.cpu?.usage ?? latest?.cpu_usage ?? latest?.cpu ?? n.cpu_usage ?? n.cpu?.usage ?? n.cpu ?? 0;
        const cpu = Number(typeof cpuRaw === 'object' ? cpuRaw?.usage ?? 0 : cpuRaw);
        const memUsed = Number(latest?.ram?.used ?? latest?.mem_used ?? n.mem_used ?? n.ram?.used ?? 0);
        const memTotal = Number(n.mem_total ?? latest?.ram?.total ?? n.ram?.total ?? 0);
        const memPct = memTotal > 0 ? Math.min(100, (memUsed / memTotal) * 100) : Number(latest?.mem_usage ?? n.mem_usage ?? 0);
        const diskUsed = Number(latest?.disk?.used ?? latest?.disk_used ?? n.disk_used ?? n.disk?.used ?? 0);
        const diskTotal = Number(n.disk_total ?? latest?.disk?.total ?? n.disk?.total ?? 0);
        const diskPct = diskTotal > 0 ? Math.min(100, (diskUsed / diskTotal) * 100) : Number(latest?.disk_usage ?? n.disk_usage ?? 0);
        const netUp = Number(latest?.network?.up ?? latest?.net_out ?? n.net_out ?? n.network?.up ?? n.up ?? 0);
        const netDown = Number(latest?.network?.down ?? latest?.net_in ?? n.net_in ?? n.network?.down ?? n.down ?? 0);
        const uptime = Number(latest?.uptime ?? n.uptime ?? 0);

        return `
          <div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 space-y-2.5 border border-slate-200/60 dark:border-white/5">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-2 h-2 rounded-full shrink-0 ${online ? 'bg-emerald-500' : 'bg-rose-500'}"></span>
                <span class="text-sm font-semibold text-slate-900 dark:text-[#f5f5f5] truncate">${name}</span>
              </div>
              <span class="text-[11px] text-[#6c7883] shrink-0">${region || (online ? 'Online' : 'Offline')}</span>
            </div>

            <div class="space-y-1.5 text-[11px]">
              <div>
                <div class="flex justify-between text-[#6c7883] mb-0.5">
                  <span>CPU</span><span>${Number.isFinite(cpu) ? cpu.toFixed(1) : '0.0'}%</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-200 dark:bg-white/10 overflow-hidden">
                  <div class="h-full bg-[#2481cc] dark:bg-[#3ea6ff]" style="width:${Math.min(100, Math.max(0, cpu))}%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-[#6c7883] mb-0.5">
                  <span>RAM</span>
                  <span>${memTotal > 0 ? `${formatBytes(memUsed)} / ${formatBytes(memTotal)}` : `${memPct.toFixed(1)}%`}</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-200 dark:bg-white/10 overflow-hidden">
                  <div class="h-full bg-emerald-500" style="width:${Math.min(100, Math.max(0, memPct))}%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-[#6c7883] mb-0.5">
                  <span>Disk</span>
                  <span>${diskTotal > 0 ? `${formatBytes(diskUsed)} / ${formatBytes(diskTotal)}` : `${diskPct.toFixed(1)}%`}</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-200 dark:bg-white/10 overflow-hidden">
                  <div class="h-full bg-violet-500" style="width:${Math.min(100, Math.max(0, diskPct))}%"></div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[11px] text-[#6c7883] pt-1 border-t border-slate-200/70 dark:border-white/5">
              <span>↑ ${formatBytes(netUp)}/s · ↓ ${formatBytes(netDown)}/s</span>
              <span>Up ${formatUptime(uptime)}</span>
            </div>
          </div>
        `;
      })
      .join('');
  }

  async function komariFetchJson(targetUrl: string, cfg: KomariConfig) {
    const headers: Record<string, string> = {};
    let fetchUrl = targetUrl;

    if (cfg.proxyUrl.trim()) {
      const idToken = await auth?.currentUser?.getIdToken();
      if (!idToken) {
        throw new Error('Not signed in to Firebase');
      }
      headers['Authorization'] = `Bearer ${idToken}`;
      if (cfg.token.trim()) {
        headers['X-Komari-Token'] = cfg.token.trim();
      }
      const sep = cfg.proxyUrl.includes('?') ? '&' : '?';
      fetchUrl = `${cfg.proxyUrl.trim()}${sep}url=${encodeURIComponent(targetUrl)}`;
    } else if (cfg.token.trim()) {
      headers['Authorization'] = `Bearer ${cfg.token.trim()}`;
    }

    const res = await fetch(fetchUrl, { headers });
    if (!res.ok) {
      throw new Error(`HTTP ${res.status} ${res.statusText}`);
    }
    return res.json();
  }

  async function fetchKomariNodes() {
    const cfg = loadConfig();
    const badge = document.getElementById('komari-status-badge');
    const updatedEl = document.getElementById('komari-last-updated');
    const grid = document.getElementById('komari-nodes-grid');

    if (!cfg.baseUrl) {
      if (badge) badge.textContent = '未配置实例';
      return;
    }

    const cleanBase = cfg.baseUrl.replace(/\/+$/, '');
    const cleanPath = cfg.apiPath.startsWith('/') ? cfg.apiPath : `/${cfg.apiPath}`;
    const endpoint = `${cleanBase}${cleanPath}`;

    if (badge) {
      badge.textContent = '● 同步中...';
      badge.className = 'px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400';
    }

    try {
      const data = await komariFetchJson(endpoint, cfg);
      const nodes = normalizeNodes(data);

      // Komari /api/nodes only returns static specs; live telemetry lives at /api/recent/:uuid
      await Promise.allSettled(
        nodes.map(async (node) => {
          if (!node?.uuid) return;
          try {
            const recentPayload = await komariFetchJson(`${cleanBase}/api/recent/${encodeURIComponent(node.uuid)}`, cfg);
            const arr = Array.isArray(recentPayload)
              ? recentPayload
              : Array.isArray(recentPayload?.data)
                ? recentPayload.data
                : [];
            if (arr.length > 0) {
              node._recent = arr[arr.length - 1];
            }
          } catch {
            // keep node metadata even if recent telemetry fails
          }
        })
      );

      renderNodes(nodes);
      const onlineCount = nodes.filter((n) => n._recent !== undefined || n.online === true).length;

      if (badge) {
        badge.textContent = `● 在线 (${onlineCount}/${nodes.length})`;
        badge.className = 'px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400';
      }
      if (updatedEl) {
        updatedEl.textContent = `更新于 ${new Date().toLocaleTimeString()}`;
      }
    } catch (err: any) {
      if (badge) {
        badge.textContent = '● 连接失败';
        badge.className = 'px-2.5 py-1 rounded-full bg-rose-500/15 text-rose-600 dark:text-rose-400';
      }
      if (grid) {
        grid.innerHTML = `
          <div class="sm:col-span-2 rounded-xl border border-rose-200 dark:border-rose-500/20 bg-rose-50/60 dark:bg-rose-500/10 p-4 text-xs text-rose-700 dark:text-rose-300 space-y-1.5">
            <div class="font-semibold">无法从浏览器请求 ${escapeHtml(endpoint)}</div>
            <div>错误：${escapeHtml(err?.message || 'Network / CORS error')}</div>
            <div class="text-[#6c7883] dark:text-slate-300">
              提示：由于本站是纯静态页面，若 Komari 后端未开启 CORS（<code>Access-Control-Allow-Origin</code>），浏览器会拦截跨域请求。你可以在反代（Nginx / Caddy / Cloudflare）添加 CORS 响应头，或将上方「展示模式」切换为「内嵌面板 (iframe)」。
            </div>
          </div>`;
      }
    }
  }

  function applyKomariMode() {
    const cfg = loadConfig();
    const apiSection = document.getElementById('komari-api-section');
    const iframeSection = document.getElementById('komari-iframe-section');
    const iframe = document.getElementById('komari-iframe') as HTMLIFrameElement | null;
    const extLink = document.getElementById('komari-external-link') as HTMLAnchorElement | null;

    if (extLink) {
      if (cfg.baseUrl) {
        extLink.href = cfg.baseUrl;
        extLink.classList.remove('hidden');
      } else {
        extLink.classList.add('hidden');
      }
    }

    if (refreshTimer) {
      clearInterval(refreshTimer);
      refreshTimer = null;
    }

    if (cfg.mode === 'iframe') {
      apiSection?.classList.add('hidden');
      iframeSection?.classList.remove('hidden');
      if (iframe && cfg.baseUrl) {
        iframe.src = cfg.baseUrl;
      }
    } else {
      iframeSection?.classList.add('hidden');
      apiSection?.classList.remove('hidden');
      if (cfg.baseUrl) {
        fetchKomariNodes();
        const autoBox = document.getElementById('komari-auto-refresh') as HTMLInputElement | null;
        if (autoBox?.checked) {
          refreshTimer = setInterval(fetchKomariNodes, 10000);
        }
      }
    }
  }

  function setupToolboxPage() {
    applyI18n();

    const googleBtn = document.getElementById('tools-google-btn') as HTMLButtonElement | null;
    const logoutBtn = document.getElementById('tools-logout-btn') as HTMLButtonElement | null;
    const userLabel = document.getElementById('tools-user-label');
    const lockedEl = document.getElementById('tools-locked');
    const lockMsg = document.getElementById('tools-lock-msg');
    const workspaceEl = document.getElementById('tools-workspace');

    const tabKomari = document.getElementById('tool-tab-komari');
    const tabBilling = document.getElementById('tool-tab-billing');
    const tabExpense = document.getElementById('tool-tab-expense');
    const panelKomari = document.getElementById('tool-panel-komari');
    const panelBilling = document.getElementById('tool-panel-billing');
    const panelExpense = document.getElementById('tool-panel-expense');

    const BILLING_URL_KEY = 'space_billing_api_url_v1';
    const billingUrlInput = document.getElementById('billing-api-url') as HTMLInputElement | null;
    const billingConfigForm = document.getElementById('billing-config-form') as HTMLFormElement | null;
    const billingSummaryGrid = document.getElementById('billing-summary-grid');
    const billingList = document.getElementById('billing-services-list');
    const billingNetEl = document.getElementById('billing-net-total');
    const billingGrossEl = document.getElementById('billing-gross-total');
    const billingCreditsEl = document.getElementById('billing-credits-total');

    if (billingUrlInput) {
      billingUrlInput.value = localStorage.getItem(BILLING_URL_KEY) || '';
    }

    const fetchBillingReport = async () => {
      const apiUrl = (localStorage.getItem(BILLING_URL_KEY) || '').trim();
      if (!apiUrl || !billingList) return;
      const user = auth?.currentUser;
      if (!user) return;

      billingList.innerHTML = `<div class="p-4 text-center text-xs text-[#6c7883]">正在查询 BigQuery 账单明细...</div>`;
      try {
        const idToken = await user.getIdToken();
        const res = await fetch(apiUrl, {
          headers: { Authorization: `Bearer ${idToken}` },
        });
        const data = await res.json();
        if (!res.ok) {
          throw new Error(data?.error || `HTTP ${res.status}`);
        }

        const cur = data.currency === 'USD' ? '$' : `${escapeHtml(data.currency || '')} `;
        billingSummaryGrid?.classList.remove('hidden');
        if (billingNetEl) billingNetEl.textContent = `${cur}${Number(data.netTotal || 0).toFixed(4)}`;
        if (billingGrossEl) billingGrossEl.textContent = `${cur}${Number(data.grossTotal || 0).toFixed(4)}`;
        if (billingCreditsEl) billingCreditsEl.textContent = `${cur}${Number(data.creditsTotal || 0).toFixed(4)}`;

        const services = Array.isArray(data.services) ? data.services : [];
        if (!services.length) {
          billingList.innerHTML = `<div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-4 text-center text-xs text-[#6c7883]">本月暂无账单记录（若刚开启 BigQuery 导出，通常需等待数小时生成首张表）。</div>`;
          return;
        }

        const maxVal = Math.max(...services.map((s: any) => Math.abs(Number(s.grossCost || s.netCost || 0))), 0.0001);
        billingList.innerHTML = services
          .map((s: any) => {
            const net = Number(s.netCost || 0);
            const gross = Number(s.grossCost || 0);
            const credits = Number(s.credits || 0);
            const pct = Math.min(100, Math.max(4, (Math.abs(gross || net) / maxVal) * 100));
            return `
              <div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3 space-y-1.5">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-medium text-slate-900 dark:text-[#f5f5f5]">${escapeHtml(s.service)}</span>
                  <span class="font-mono text-slate-900 dark:text-[#f5f5f5]">${cur}${net.toFixed(4)}</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-200 dark:bg-white/10 overflow-hidden">
                  <div class="h-full bg-[#2481cc] dark:bg-[#3ea6ff]" style="width:${pct}%"></div>
                </div>
                <div class="flex justify-between text-[11px] text-[#6c7883]">
                  <span>原价 ${cur}${gross.toFixed(4)}</span>
                  <span>抵扣 ${cur}${credits.toFixed(4)}</span>
                </div>
              </div>
            `;
          })
          .join('');
      } catch (err: any) {
        billingList.innerHTML = `
          <div class="rounded-xl border border-rose-200 dark:border-rose-500/20 bg-rose-50/60 dark:bg-rose-500/10 p-4 text-xs text-rose-700 dark:text-rose-300">
            查询失败：${escapeHtml(err?.message || 'Unknown error')}
          </div>`;
      }
    };

    const syncSettingsToFirestore = async (patch: Record<string, unknown>) => {
      if (!db || !auth?.currentUser || auth.currentUser.email !== ADMIN_EMAIL) return;
      try {
        await setDoc(
          doc(db, 'admin_settings', 'toolbox'),
          { ...patch, updatedAt: serverTimestamp() },
          { merge: true }
        );
      } catch (err) {
        console.warn('[Toolbox] Failed to sync settings to Firestore:', err);
      }
    };

    const loadSettingsFromFirestore = async () => {
      if (!db || !auth?.currentUser || auth.currentUser.email !== ADMIN_EMAIL) return;
      try {
        const snap = await getDoc(doc(db, 'admin_settings', 'toolbox'));
        if (!snap.exists()) return;
        const data = snap.data() as any;

        if (data.komari && typeof data.komari === 'object') {
          const merged: KomariConfig = {
            baseUrl: typeof data.komari.baseUrl === 'string' ? data.komari.baseUrl : '',
            apiPath: typeof data.komari.apiPath === 'string' && data.komari.apiPath ? data.komari.apiPath : '/api/nodes',
            token: typeof data.komari.token === 'string' ? data.komari.token : '',
            proxyUrl: typeof data.komari.proxyUrl === 'string' ? data.komari.proxyUrl : '',
            mode: data.komari.mode === 'iframe' ? 'iframe' : 'api',
          };
          saveConfig(merged);
          if (urlInput) urlInput.value = merged.baseUrl;
          if (pathInput) pathInput.value = merged.apiPath;
          if (tokenInput) tokenInput.value = merged.token;
          if (proxyInput) proxyInput.value = merged.proxyUrl;
          if (modeSelect) modeSelect.value = merged.mode;
          if (merged.baseUrl) configForm?.classList.add('hidden');
          applyKomariMode();
        }

        if (typeof data.billingApiUrl === 'string' && data.billingApiUrl.trim()) {
          localStorage.setItem(BILLING_URL_KEY, data.billingApiUrl.trim());
          if (billingUrlInput) billingUrlInput.value = data.billingApiUrl.trim();
        }

        if (data.subHub && typeof data.subHub === 'object') {
          applySubConfig(data.subHub);
        }

        if (data.uhdConfig && typeof data.uhdConfig === 'object') {
          applyUhdConfig(data.uhdConfig);
        } else if (typeof data.uhdNote === 'string') {
          applyUhdConfig({ note: data.uhdNote });
        }

        if (Array.isArray(data.renewals)) {
          renewals = data.renewals;
          localStorage.setItem(RENEWALS_KEY, JSON.stringify(renewals));
          renderRenewals();
        }
      } catch (err) {
        console.warn('[Toolbox] Failed to load settings from Firestore:', err);
      }
    };

    interface UhdConfig {
      apiUrl: string;
      apiToken: string;
      embyUrl: string;
      embyToken: string;
      embyUserId: string;
      username: string;
      password: string;
      proxyUrl: string;
      note: string;
    }

    const DEFAULT_UHD_EMBY_URL = '';
    const UHD_CFG_KEY = 'space_uhd_config_v2';
    const uhdConfigForm = document.getElementById('uhd-config-form') as HTMLFormElement | null;
    const uhdApiUrlInput = document.getElementById('uhd-api-url') as HTMLInputElement | null;
    const uhdApiTokenInput = document.getElementById('uhd-api-token') as HTMLInputElement | null;
    const uhdEmbyUrlInput = document.getElementById('uhd-emby-url') as HTMLInputElement | null;
    const uhdEmbyTokenInput = document.getElementById('uhd-emby-token') as HTMLInputElement | null;
    const uhdUsernameInput = document.getElementById('uhd-username') as HTMLInputElement | null;
    const uhdPasswordInput = document.getElementById('uhd-password') as HTMLInputElement | null;
    const uhdProxyUrlInput = document.getElementById('uhd-proxy-url') as HTMLInputElement | null;
    const uhdNoteInput = document.getElementById('uhd-note-input') as HTMLInputElement | null;

    let currentUhdCfg: UhdConfig = {
      apiUrl: '',
      apiToken: '',
      embyUrl: DEFAULT_UHD_EMBY_URL,
      embyToken: '',
      embyUserId: '',
      username: '',
      password: '',
      proxyUrl: '',
      note: localStorage.getItem('space_uhd_note_v1') || '',
    };

    const loadUhdCfg = (): UhdConfig => {
      try {
        const raw = localStorage.getItem(UHD_CFG_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          return {
            apiUrl: typeof p.apiUrl === 'string' ? p.apiUrl : '',
            apiToken: typeof p.apiToken === 'string' ? p.apiToken : '',
            embyUrl: typeof p.embyUrl === 'string' && p.embyUrl ? p.embyUrl : DEFAULT_UHD_EMBY_URL,
            embyToken: typeof p.embyToken === 'string' ? p.embyToken : '',
            embyUserId: typeof p.embyUserId === 'string' ? p.embyUserId : '',
            username: typeof p.username === 'string' ? p.username : '',
            password: typeof p.password === 'string' ? p.password : '',
            proxyUrl: typeof p.proxyUrl === 'string' ? p.proxyUrl : '',
            note: typeof p.note === 'string' ? p.note : '',
          };
        }
      } catch {
        // ignore
      }
      return currentUhdCfg;
    };

    const applyUhdConfig = (partial: Partial<UhdConfig>) => {
      currentUhdCfg = {
        ...currentUhdCfg,
        ...partial,
        embyUrl: partial.embyUrl || currentUhdCfg.embyUrl || DEFAULT_UHD_EMBY_URL,
      };
      localStorage.setItem(UHD_CFG_KEY, JSON.stringify(currentUhdCfg));
      if (uhdApiUrlInput) uhdApiUrlInput.value = currentUhdCfg.apiUrl;
      if (uhdApiTokenInput) uhdApiTokenInput.value = currentUhdCfg.apiToken;
      if (uhdEmbyUrlInput) uhdEmbyUrlInput.value = currentUhdCfg.embyUrl;
      if (uhdEmbyTokenInput) uhdEmbyTokenInput.value = currentUhdCfg.embyToken;
      if (uhdUsernameInput) uhdUsernameInput.value = currentUhdCfg.username;
      if (uhdPasswordInput) uhdPasswordInput.value = currentUhdCfg.password;
      if (uhdProxyUrlInput) uhdProxyUrlInput.value = currentUhdCfg.proxyUrl;
      if (uhdNoteInput) uhdNoteInput.value = currentUhdCfg.note;
      if (currentUhdCfg.embyToken || (currentUhdCfg.username && currentUhdCfg.password) || currentUhdCfg.apiUrl) {
        uhdConfigForm?.classList.add('hidden');
      }
    };

    applyUhdConfig(loadUhdCfg());

    document.getElementById('uhd-toggle-config-btn')?.addEventListener('click', () => {
      uhdConfigForm?.classList.toggle('hidden');
    });

    const parseExpireDate = (val: unknown): Date | null => {
      if (val === null || val === undefined || val === '') return null;
      if (typeof val === 'number' && Number.isFinite(val)) {
        const ms = val > 1e12 ? val : val * 1000;
        const d = new Date(ms);
        return Number.isNaN(d.getTime()) ? null : d;
      }
      if (typeof val === 'string') {
        const num = Number(val);
        if (Number.isFinite(num) && val.trim() !== '') {
          const ms = num > 1e12 ? num : num * 1000;
          const d = new Date(ms);
          return Number.isNaN(d.getTime()) ? null : d;
        }
        const d = new Date(val);
        return Number.isNaN(d.getTime()) ? null : d;
      }
      return null;
    };

    const pickField = (obj: any, keys: string[]): unknown => {
      if (!obj || typeof obj !== 'object') return undefined;
      for (const k of keys) {
        if (obj[k] !== undefined && obj[k] !== null && obj[k] !== '') return obj[k];
      }
      return undefined;
    };

    const fetchUhdStatus = async () => {
      const cfg = loadUhdCfg();
      const daysEl = document.getElementById('uhd-days-val');
      const expireSubEl = document.getElementById('uhd-expire-sub');
      const planEl = document.getElementById('uhd-plan-val');
      const trafficSubEl = document.getElementById('uhd-traffic-sub');
      const embyStatusEl = document.getElementById('uhd-emby-status');
      const embyCountsEl = document.getElementById('uhd-emby-counts');
      const domainsBox = document.getElementById('uhd-domains-box');
      const domainsList = document.getElementById('uhd-domains-list');
      const rawDetails = document.getElementById('uhd-raw-details');
      const rawJsonEl = document.getElementById('uhd-raw-json');

      const debugChunks: Record<string, unknown> = {};

      let discoveredEmbyUrl = cfg.embyUrl.trim().replace(/\/+$/, '');
      let domainsRenderedByProxy = false;
      let embyHandledByProxy = false;

      // 1. Fetch UHDNOW account / subscription via uhdProxy (preferred) or custom apiUrl
      if (cfg.proxyUrl.trim() && cfg.username.trim() && cfg.password) {
        if (daysEl) daysEl.textContent = '登录同步中...';
        if (embyStatusEl) embyStatusEl.textContent = '连接中...';
        try {
          const idToken = await auth?.currentUser?.getIdToken();
          if (!idToken) throw new Error('请先使用管理员 Google 账号登录');
          const res = await fetch(cfg.proxyUrl.trim(), {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${idToken}`,
            },
            body: JSON.stringify({
              username: cfg.username.trim(),
              password: cfg.password,
              ...(discoveredEmbyUrl ? { embyUrl: discoveredEmbyUrl } : {}),
            }),
          });
          const payload = await res.json();
          debugChunks.uhdProxy = payload;
          if (!res.ok || !payload?.ok) {
            throw new Error(payload?.error || `HTTP ${res.status}`);
          }

          const sub = payload.subscription || {};
          const user = payload.user || {};
          const traffic = payload.traffic || {};
          const domains = Array.isArray(payload.domains) ? payload.domains : [];

          const expireDate = parseExpireDate(sub.expires_at);
          if (daysEl) {
            if (expireDate) {
              const daysLeft = Math.ceil((expireDate.getTime() - Date.now()) / 86400000);
              daysEl.textContent = daysLeft < 0 ? `已过期 ${Math.abs(daysLeft)} 天` : daysLeft === 0 ? '今天到期' : `剩余 ${daysLeft} 天`;
              daysEl.className = `text-lg font-semibold mt-1 ${
                daysLeft <= 3 ? 'text-rose-500' : daysLeft <= 7 ? 'text-amber-500' : 'text-emerald-600 dark:text-emerald-400'
              }`;
            } else {
              daysEl.textContent = '暂无有效订阅';
            }
          }
          if (expireSubEl) {
            const parts: string[] = [];
            if (expireDate) parts.push(`到期 ${expireDate.toISOString().slice(0, 10)}`);
            if (typeof sub.auto_renew === 'boolean') parts.push(sub.auto_renew ? '自动续费已开启' : '未开自动续费');
            if (typeof user.balance === 'number') parts.push(`余额 $${user.balance.toFixed(2)}`);
            expireSubEl.textContent = parts.join(' · ') || '-';
          }

          const plan = sub.plan || {};
          if (planEl) {
            const pName = plan.name || '已激活';
            const pPrice = typeof plan.monthly_price === 'number' ? ` ($${plan.monthly_price}/月)` : '';
            planEl.textContent = `${pName}${pPrice}`;
          }
          if (trafficSubEl) {
            if (traffic.display_unlimited_traffic) {
              trafficSubEl.textContent = `已用 ${formatBytes(Number(traffic.used_bytes || 0))} / 不限流量`;
            } else if (Number(traffic.limit_bytes || 0) > 0) {
              trafficSubEl.textContent = `已用 ${formatBytes(Number(traffic.used_bytes || 0))} / ${formatBytes(Number(traffic.limit_bytes))}`;
            } else {
              trafficSubEl.textContent = '-';
            }
          }

          if (domains.length && domainsList && domainsBox) {
            domainsRenderedByProxy = true;
            domainsBox.classList.remove('hidden');
            domainsList.innerHTML = domains
              .map(
                (d: any) => `
                <div class="flex items-center justify-between gap-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] px-3 py-2">
                  <div class="min-w-0">
                    <div class="font-medium text-slate-900 dark:text-[#f5f5f5] truncate">${escapeHtml(d.name || '线路')}</div>
                    <div class="font-mono text-[11px] text-[#6c7883] truncate">${escapeHtml(d.domain || '')}${d.description ? ` · ${escapeHtml(d.description)}` : ''}</div>
                  </div>
                  <button type="button" data-copy-emby="${escapeHtml(d.domain || '')}" class="shrink-0 px-2.5 py-1 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] cursor-pointer">
                    复制
                  </button>
                </div>`
              )
              .join('');
            domainsList.querySelectorAll<HTMLButtonElement>('[data-copy-emby]').forEach((btn) => {
              btn.addEventListener('click', () => {
                const u = btn.dataset.copyEmby || '';
                if (!u) return;
                navigator.clipboard?.writeText(u);
                btn.textContent = '已复制 ✓';
                setTimeout(() => {
                  btn.textContent = '复制';
                }, 1200);
              });
            });
            if (!discoveredEmbyUrl && domains[0]?.domain) {
              discoveredEmbyUrl = String(domains[0].domain).trim().replace(/\/+$/, '');
            }
          }

          if (payload.emby && typeof payload.emby === 'object') {
            embyHandledByProxy = true;
            if (payload.emby.ok) {
              if (embyStatusEl) {
                embyStatusEl.textContent = payload.emby.serverName || 'Emby 在线';
                embyStatusEl.className = 'text-lg font-semibold text-emerald-600 dark:text-emerald-400 mt-1';
              }
              if (embyCountsEl) {
                const parts: string[] = [];
                if (payload.emby.version) parts.push(`v${payload.emby.version}`);
                if (payload.emby.movieCount !== null && payload.emby.movieCount !== undefined) parts.push(`电影 ${payload.emby.movieCount}`);
                if (payload.emby.seriesCount !== null && payload.emby.seriesCount !== undefined) parts.push(`剧集 ${payload.emby.seriesCount}`);
                embyCountsEl.textContent = parts.join(' · ') || payload.emby.url || 'Online';
              }
            } else {
              if (embyStatusEl) {
                embyStatusEl.textContent = 'Emby 连接失败';
                embyStatusEl.className = 'text-lg font-semibold text-rose-500 mt-1';
              }
              if (embyCountsEl) embyCountsEl.textContent = String(payload.emby.error || '请检查线路');
            }
          }
        } catch (err: any) {
          debugChunks.uhdProxyError = err?.message || String(err);
          if (daysEl) {
            daysEl.textContent = '同步失败';
            daysEl.className = 'text-lg font-semibold text-rose-500 mt-1';
          }
          if (expireSubEl) {
            expireSubEl.textContent = `${err?.message || '请求失败'}`;
          }
        }
      } else if (!cfg.apiUrl) {
        if (daysEl) daysEl.textContent = '待配置代理';
        if (expireSubEl) expireSubEl.textContent = '展开「API 配置」填入 uhdProxy 地址与账密';
      } else {
        if (daysEl) daysEl.textContent = '查询中...';
        try {
          const headers: Record<string, string> = {};
          let targetUrl = cfg.apiUrl.trim();
          if (cfg.apiToken.trim()) {
            const tok = cfg.apiToken.trim();
            headers['Authorization'] = tok.toLowerCase().startsWith('bearer ') ? tok : `Bearer ${tok}`;
          }
          const res = await fetch(targetUrl, { headers });
          if (!res.ok) throw new Error(`HTTP ${res.status} ${res.statusText}`);
          const payload = await res.json();
          debugChunks.accountApi = payload;

          const root = payload?.data?.user || payload?.data?.subscription || payload?.data || payload?.user || payload?.subscription || payload;
          const rawDays = pickField(root, ['remaining_days', 'days_left', 'remain_days', 'left_days']);
          const rawExpire = pickField(root, [
            'expired_at',
            'expire_at',
            'expires_at',
            'expire_time',
            'expireTime',
            'end_date',
            'end_at',
            'next_billing_date',
            'valid_until',
          ]);

          const expireDate = parseExpireDate(rawExpire);
          let daysLeft: number | null = typeof rawDays === 'number' ? rawDays : rawDays !== undefined ? Number(rawDays) : null;
          if ((daysLeft === null || !Number.isFinite(daysLeft)) && expireDate) {
            daysLeft = Math.ceil((expireDate.getTime() - Date.now()) / 86400000);
          }

          if (daysEl) {
            if (daysLeft !== null && Number.isFinite(daysLeft)) {
              daysEl.textContent = daysLeft < 0 ? `已过期 ${Math.abs(daysLeft)} 天` : daysLeft === 0 ? '今天到期' : `剩余 ${daysLeft} 天`;
              daysEl.className = `text-lg font-semibold mt-1 ${
                daysLeft <= 3 ? 'text-rose-500' : daysLeft <= 7 ? 'text-amber-500' : 'text-emerald-600 dark:text-emerald-400'
              }`;
            } else {
              daysEl.textContent = '已连接 (未识别到期字段)';
            }
          }
          if (expireSubEl) {
            expireSubEl.textContent = expireDate ? `到期时间：${expireDate.toISOString().slice(0, 10)}` : '可在下方展开原始 JSON 核对字段';
          }

          const planName = pickField(root, ['plan_name', 'plan', 'package_name', 'level', 'group_name', 'tier']);
          if (planEl) planEl.textContent = planName ? String(planName) : '已激活';

          const usedBytes = Number(pickField(root, ['used_traffic', 'traffic_used', 'used_bytes']) ?? (Number(root?.u || 0) + Number(root?.d || 0)));
          const totalBytes = Number(pickField(root, ['transfer_enable', 'total_traffic', 'traffic_limit', 'total_bytes']) ?? 0);
          if (trafficSubEl) {
            if (totalBytes > 0) {
              trafficSubEl.textContent = `已用 ${formatBytes(usedBytes)} / ${formatBytes(totalBytes)}`;
            } else if (usedBytes > 0) {
              trafficSubEl.textContent = `已用 ${formatBytes(usedBytes)}`;
            } else {
              trafficSubEl.textContent = '流量数据未返回';
            }
          }
        } catch (err: any) {
          debugChunks.accountApiError = err?.message || String(err);
          if (daysEl) {
            daysEl.textContent = 'API 请求失败';
            daysEl.className = 'text-lg font-semibold text-rose-500 mt-1';
          }
          if (expireSubEl) {
            expireSubEl.textContent = `${err?.message || 'CORS / 网络错误'}`;
          }
        }
      }

      // 2. Authenticate with Emby (if needed) & fetch Server Info + Counts + ServerDomains
      if (embyHandledByProxy) {
        // Already fetched server-side via uhdProxy
      } else if (!discoveredEmbyUrl) {
        if (embyStatusEl) embyStatusEl.textContent = '未配置 Emby';
        if (embyCountsEl) embyCountsEl.textContent = '同步官网后将自动获取线路';
        if (!domainsRenderedByProxy) domainsBox?.classList.add('hidden');
      } else {
        const cleanEmby = discoveredEmbyUrl;
        if (embyStatusEl) embyStatusEl.textContent = '连接中...';
        try {
          let activeToken = cfg.embyToken.trim();
          let activeUserId = cfg.embyUserId.trim();

          if (!activeToken && cfg.username.trim() && cfg.password) {
            const authRes = await fetch(`${cleanEmby}/emby/Users/AuthenticateByName`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-Emby-Authorization': 'MediaBrowser Client="SpaceToolbox", Device="Web", DeviceId="space-toolbox-web", Version="1.0.0"',
              },
              body: JSON.stringify({ Username: cfg.username.trim(), Pw: cfg.password }),
            });
            if (!authRes.ok) {
              throw new Error(`Emby 登录失败 (HTTP ${authRes.status})`);
            }
            const authData = await authRes.json();
            debugChunks.embyAuth = {
              User: authData?.User?.Name,
              UserId: authData?.User?.Id,
              ServerId: authData?.ServerId,
              Policy: authData?.User?.Policy,
            };
            if (authData?.AccessToken) {
              activeToken = authData.AccessToken;
              activeUserId = authData?.User?.Id || '';
              applyUhdConfig({ embyToken: activeToken, embyUserId: activeUserId });
              await syncSettingsToFirestore({ uhdConfig: currentUhdCfg });
            }
          }

          const tokenParam = activeToken ? `?X-Emby-Token=${encodeURIComponent(activeToken)}` : '';
          const [infoRes, countsRes, domainsRes] = await Promise.allSettled([
            fetch(`${cleanEmby}/emby/System/Info${tokenParam}`).then((r) => (r.ok ? r.json() : Promise.reject(new Error(`Info HTTP ${r.status}`)))),
            fetch(`${cleanEmby}/emby/Items/Counts${tokenParam}`).then((r) => (r.ok ? r.json() : null)),
            fetch(`${cleanEmby}/emby/System/Ext/ServerDomains${tokenParam}`).then((r) => (r.ok ? r.json() : null)),
          ]);

          if (infoRes.status === 'fulfilled' && infoRes.value) {
            debugChunks.embyInfo = infoRes.value;
            if (embyStatusEl) {
              embyStatusEl.textContent = infoRes.value.ServerName || 'Emby 在线';
              embyStatusEl.className = 'text-lg font-semibold text-emerald-600 dark:text-emerald-400 mt-1';
            }
            const ver = infoRes.value.Version ? `v${infoRes.value.Version}` : 'Online';
            if (countsRes.status === 'fulfilled' && countsRes.value) {
              const c = countsRes.value;
              if (embyCountsEl) {
                embyCountsEl.textContent = `${ver} · 电影 ${c.MovieCount ?? 0} · 剧集 ${c.SeriesCount ?? 0}`;
              }
            } else if (embyCountsEl) {
              embyCountsEl.textContent = ver;
            }
          } else {
            const reason = infoRes.status === 'rejected' ? infoRes.reason?.message : 'HTTP Error';
            debugChunks.embyError = reason;
            if (embyStatusEl) {
              embyStatusEl.textContent = 'Emby 连接失败';
              embyStatusEl.className = 'text-lg font-semibold text-rose-500 mt-1';
            }
            if (embyCountsEl) embyCountsEl.textContent = String(reason || '');
          }

          if (!domainsRenderedByProxy && domainsRes.status === 'fulfilled' && domainsRes.value?.ok && Array.isArray(domainsRes.value?.data)) {
            debugChunks.serverDomains = domainsRes.value.data;
            if (domainsList && domainsBox) {
              domainsBox.classList.remove('hidden');
              domainsList.innerHTML = domainsRes.value.data
                .map(
                  (d: any) => `
                  <div class="flex items-center justify-between gap-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] px-3 py-2">
                    <div class="min-w-0">
                      <div class="font-medium text-slate-900 dark:text-[#f5f5f5] truncate">${escapeHtml(d.name || 'Line')}</div>
                      <div class="font-mono text-[11px] text-[#6c7883] truncate">${escapeHtml(d.url || '')}</div>
                    </div>
                    <button type="button" data-copy-emby="${escapeHtml(d.url || '')}" class="shrink-0 px-2.5 py-1 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] cursor-pointer">
                      复制
                    </button>
                  </div>`
                )
                .join('');
              domainsList.querySelectorAll<HTMLButtonElement>('[data-copy-emby]').forEach((btn) => {
                btn.addEventListener('click', () => {
                  const u = btn.dataset.copyEmby || '';
                  if (!u) return;
                  navigator.clipboard?.writeText(u);
                  btn.textContent = '已复制 ✓';
                  setTimeout(() => {
                    btn.textContent = '复制';
                  }, 1200);
                });
              });
            }
          } else if (!domainsRenderedByProxy) {
            domainsBox?.classList.add('hidden');
          }
        } catch (err: any) {
          debugChunks.embyException = err?.message || String(err);
          if (embyStatusEl) {
            embyStatusEl.textContent = 'Emby 登录/连接失败';
            embyStatusEl.className = 'text-lg font-semibold text-rose-500 mt-1';
          }
          if (embyCountsEl) embyCountsEl.textContent = String(err?.message || '');
        }
      }

      if (Object.keys(debugChunks).length > 0 && rawDetails && rawJsonEl) {
        rawDetails.classList.remove('hidden');
        rawJsonEl.textContent = JSON.stringify(debugChunks, null, 2);
      }
    };

    uhdConfigForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const next: UhdConfig = {
        apiUrl: (uhdApiUrlInput?.value || '').trim(),
        apiToken: (uhdApiTokenInput?.value || '').trim(),
        embyUrl: (uhdEmbyUrlInput?.value || DEFAULT_UHD_EMBY_URL).trim().replace(/\/+$/, ''),
        embyToken: (uhdEmbyTokenInput?.value || '').trim(),
        embyUserId: currentUhdCfg.embyUserId || '',
        username: (uhdUsernameInput?.value || '').trim(),
        password: uhdPasswordInput?.value || '',
        proxyUrl: (uhdProxyUrlInput?.value || '').trim(),
        note: (uhdNoteInput?.value || '').trim(),
      };
      applyUhdConfig(next);
      await syncSettingsToFirestore({ uhdConfig: next });
      await fetchUhdStatus();
    });

    document.getElementById('uhd-refresh-btn')?.addEventListener('click', fetchUhdStatus);

    interface RenewalItem {
      name: string;
      url: string;
      price: number;
      nextDate: string;
    }

    const RENEWALS_KEY = 'space_renewals_v1';
    const renewalsListEl = document.getElementById('renewals-list');
    const renewalsTotalEl = document.getElementById('renewals-monthly-total');

    const defaultNextMonthDate = () => {
      const d = new Date();
      d.setMonth(d.getMonth() + 1);
      return d.toISOString().slice(0, 10);
    };

    let renewals: RenewalItem[] = [
      { name: 'UHDNOW (Emby)', url: 'https://www.uhdnow.com/', price: 1.2, nextDate: defaultNextMonthDate() },
    ];
    try {
      const raw = localStorage.getItem(RENEWALS_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) renewals = parsed;
      }
    } catch {
      // ignore
    }

    const saveRenewals = () => {
      localStorage.setItem(RENEWALS_KEY, JSON.stringify(renewals));
      syncSettingsToFirestore({ renewals });
      renderRenewals();
    };

    const renderRenewals = () => {
      if (!renewalsListEl) return;
      const total = renewals.reduce((acc, r) => acc + (Number(r.price) || 0), 0);
      if (renewalsTotalEl) renewalsTotalEl.textContent = `$${total.toFixed(2)}`;

      if (!renewals.length) {
        renewalsListEl.innerHTML = `<div class="rounded-xl border border-dashed border-slate-200 dark:border-white/10 p-4 text-center text-[#6c7883]">暂无续费记录，可在下方添加。</div>`;
        return;
      }

      const todayMs = new Date().setHours(0, 0, 0, 0);
      renewalsListEl.innerHTML = renewals
        .map((r, idx) => {
          const targetMs = new Date(r.nextDate).setHours(0, 0, 0, 0);
          const daysLeft = Number.isFinite(targetMs) ? Math.ceil((targetMs - todayMs) / 86400000) : 0;
          const badgeCls =
            daysLeft <= 3
              ? 'bg-rose-500/15 text-rose-600 dark:text-rose-400'
              : daysLeft <= 7
                ? 'bg-amber-500/15 text-amber-600 dark:text-amber-400'
                : 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400';
          const daysLabel = daysLeft < 0 ? `已过期 ${Math.abs(daysLeft)} 天` : daysLeft === 0 ? '今天到期' : `剩余 ${daysLeft} 天`;

          return `
            <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] px-3.5 py-2.5">
              <div class="flex items-center gap-2.5 min-w-0">
                ${
                  r.url
                    ? `<a href="${escapeHtml(r.url)}" target="_blank" rel="noopener noreferrer" class="font-medium text-[#2481cc] dark:text-[#3ea6ff] hover:underline truncate">${escapeHtml(r.name)} ↗</a>`
                    : `<span class="font-medium text-slate-900 dark:text-[#f5f5f5] truncate">${escapeHtml(r.name)}</span>`
                }
                <span class="px-2 py-0.5 rounded-full text-[11px] ${badgeCls}">${daysLabel}</span>
              </div>
              <div class="flex items-center gap-3 text-[11px] text-[#6c7883]">
                <span class="font-mono text-slate-900 dark:text-[#f5f5f5]">$${Number(r.price || 0).toFixed(2)}/月</span>
                <span>${escapeHtml(r.nextDate)}</span>
                <button type="button" data-renew-bump="${idx}" class="px-2 py-0.5 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] cursor-pointer">+1月</button>
                <button type="button" data-renew-del="${idx}" class="text-rose-500 hover:underline cursor-pointer">删除</button>
              </div>
            </div>`;
        })
        .join('');

      renewalsListEl.querySelectorAll<HTMLButtonElement>('[data-renew-bump]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const i = Number(btn.dataset.renewBump);
          const item = renewals[i];
          if (!item) return;
          const d = new Date(item.nextDate || Date.now());
          d.setMonth(d.getMonth() + 1);
          item.nextDate = d.toISOString().slice(0, 10);
          saveRenewals();
        });
      });

      renewalsListEl.querySelectorAll<HTMLButtonElement>('[data-renew-del]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const i = Number(btn.dataset.renewDel);
          renewals.splice(i, 1);
          saveRenewals();
        });
      });
    };

    const renewalDateInput = document.getElementById('renewal-date') as HTMLInputElement | null;
    if (renewalDateInput && !renewalDateInput.value) {
      renewalDateInput.value = defaultNextMonthDate();
    }
    renderRenewals();

    document.getElementById('renewal-add-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameEl = document.getElementById('renewal-name') as HTMLInputElement | null;
      const urlEl = document.getElementById('renewal-url') as HTMLInputElement | null;
      const priceEl = document.getElementById('renewal-price') as HTMLInputElement | null;
      const dateEl = document.getElementById('renewal-date') as HTMLInputElement | null;
      const name = (nameEl?.value || '').trim();
      if (!name) return;
      renewals.push({
        name,
        url: (urlEl?.value || '').trim(),
        price: Number(priceEl?.value || 0),
        nextDate: dateEl?.value || defaultNextMonthDate(),
      });
      if (nameEl) nameEl.value = '';
      if (urlEl) urlEl.value = '';
      if (priceEl) priceEl.value = '';
      saveRenewals();
    });

    interface SubUpstream {
      name: string;
      url: string;
      enabled: boolean;
    }
    interface SubConfig {
      apiUrl: string;
      subToken: string;
      upstreams: SubUpstream[];
      customNodes: string;
    }

    const SUB_STORAGE_KEY = 'space_subhub_config_v1';
    const subApiInput = document.getElementById('sub-api-url') as HTMLInputElement | null;
    const subTokenInput = document.getElementById('sub-token-input') as HTMLInputElement | null;
    const subCustomInput = document.getElementById('sub-custom-nodes') as HTMLTextAreaElement | null;
    const subUpstreamsEl = document.getElementById('sub-upstreams-list');
    const subLinksBox = document.getElementById('sub-links-box');
    const subTelemetryGrid = document.getElementById('sub-telemetry-grid');
    const subSaveStatus = document.getElementById('sub-save-status');

    let currentSubCfg: SubConfig = { apiUrl: '', subToken: '', upstreams: [], customNodes: '' };
    try {
      const raw = localStorage.getItem(SUB_STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        currentSubCfg = {
          apiUrl: typeof parsed.apiUrl === 'string' ? parsed.apiUrl : '',
          subToken: typeof parsed.subToken === 'string' ? parsed.subToken : '',
          upstreams: Array.isArray(parsed.upstreams) ? parsed.upstreams : [],
          customNodes: typeof parsed.customNodes === 'string' ? parsed.customNodes : '',
        };
      }
    } catch {
      // ignore
    }

    const updateSubLinks = () => {
      const api = (subApiInput?.value || '').trim().replace(/\/+$/, '');
      const tok = (subTokenInput?.value || '').trim();
      if (subLinksBox) {
        subLinksBox.classList.toggle('hidden', !api || !tok);
      }
    };

    const renderUpstreams = () => {
      if (!subUpstreamsEl) return;
      if (!currentSubCfg.upstreams.length) {
        subUpstreamsEl.innerHTML = `<div class="rounded-xl border border-dashed border-slate-200 dark:border-white/10 p-3 text-center text-[#6c7883]">暂无上游订阅，可在下方添加。</div>`;
        return;
      }
      subUpstreamsEl.innerHTML = currentSubCfg.upstreams
        .map(
          (u, idx) => `
          <div class="flex items-center justify-between gap-2 rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] px-3 py-2">
            <label class="flex items-center gap-2 min-w-0 flex-1 cursor-pointer">
              <input type="checkbox" data-sub-toggle="${idx}" ${u.enabled !== false ? 'checked' : ''} class="accent-[#2481cc]" />
              <span class="font-medium text-slate-900 dark:text-[#f5f5f5] shrink-0">${escapeHtml(u.name || `Sub #${idx + 1}`)}</span>
              <span class="text-[#6c7883] truncate">${escapeHtml(u.url)}</span>
            </label>
            <button type="button" data-sub-del="${idx}" class="text-rose-500 hover:underline shrink-0 cursor-pointer">删除</button>
          </div>`
        )
        .join('');

      subUpstreamsEl.querySelectorAll<HTMLInputElement>('[data-sub-toggle]').forEach((cb) => {
        cb.addEventListener('change', () => {
          const i = Number(cb.dataset.subToggle);
          if (currentSubCfg.upstreams[i]) {
            currentSubCfg.upstreams[i].enabled = cb.checked;
          }
        });
      });
      subUpstreamsEl.querySelectorAll<HTMLButtonElement>('[data-sub-del]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const i = Number(btn.dataset.subDel);
          currentSubCfg.upstreams.splice(i, 1);
          renderUpstreams();
        });
      });
    };

    const applySubConfig = (cfg: any) => {
      currentSubCfg = {
        apiUrl: typeof cfg.apiUrl === 'string' ? cfg.apiUrl : '',
        subToken: typeof cfg.subToken === 'string' ? cfg.subToken : '',
        upstreams: Array.isArray(cfg.upstreams) ? cfg.upstreams : [],
        customNodes: typeof cfg.customNodes === 'string' ? cfg.customNodes : '',
      };
      localStorage.setItem(SUB_STORAGE_KEY, JSON.stringify(currentSubCfg));
      if (subApiInput) subApiInput.value = currentSubCfg.apiUrl;
      if (subTokenInput) subTokenInput.value = currentSubCfg.subToken;
      if (subCustomInput) subCustomInput.value = currentSubCfg.customNodes;
      renderUpstreams();
      updateSubLinks();
    };

    applySubConfig(currentSubCfg);

    document.getElementById('sub-gen-token-btn')?.addEventListener('click', () => {
      const arr = new Uint8Array(16);
      crypto.getRandomValues(arr);
      const tok = Array.from(arr, (b) => b.toString(16).padStart(2, '0')).join('');
      if (subTokenInput) subTokenInput.value = tok;
      updateSubLinks();
    });

    document.getElementById('sub-add-upstream-btn')?.addEventListener('click', () => {
      const nameEl = document.getElementById('sub-new-name') as HTMLInputElement | null;
      const urlEl = document.getElementById('sub-new-url') as HTMLInputElement | null;
      const url = (urlEl?.value || '').trim();
      if (!url) return;
      const name = (nameEl?.value || '').trim() || new URL(url).hostname;
      currentSubCfg.upstreams.push({ name, url, enabled: true });
      if (nameEl) nameEl.value = '';
      if (urlEl) urlEl.value = '';
      renderUpstreams();
    });

    const saveSubConfig = async () => {
      currentSubCfg.apiUrl = (subApiInput?.value || '').trim().replace(/\/+$/, '');
      currentSubCfg.subToken = (subTokenInput?.value || '').trim();
      currentSubCfg.customNodes = subCustomInput?.value || '';
      localStorage.setItem(SUB_STORAGE_KEY, JSON.stringify(currentSubCfg));
      updateSubLinks();
      await syncSettingsToFirestore({ subHub: currentSubCfg });
      if (subSaveStatus) subSaveStatus.textContent = `已保存并同步到云端 (${new Date().toLocaleTimeString()})`;
    };

    document.getElementById('sub-save-btn')?.addEventListener('click', saveSubConfig);

    const copySubLink = async (format: 'base64' | 'raw', btnId: string) => {
      const api = (subApiInput?.value || '').trim().replace(/\/+$/, '');
      const tok = (subTokenInput?.value || '').trim();
      if (!api || !tok) return;
      const link = `${api}?token=${encodeURIComponent(tok)}&format=${format}`;
      await navigator.clipboard.writeText(link);
      const btn = document.getElementById(btnId);
      if (btn) {
        const old = btn.textContent;
        btn.textContent = '已复制 ✓';
        setTimeout(() => {
          btn.textContent = old;
        }, 1500);
      }
    };
    document.getElementById('sub-copy-base64')?.addEventListener('click', () => copySubLink('base64', 'sub-copy-base64'));
    document.getElementById('sub-copy-raw')?.addEventListener('click', () => copySubLink('raw', 'sub-copy-raw'));

    const inspectSubTraffic = async () => {
      const api = (subApiInput?.value || '').trim().replace(/\/+$/, '');
      if (!api || !subTelemetryGrid) return;
      const user = auth?.currentUser;
      if (!user) return;

      subTelemetryGrid.innerHTML = `<div class="sm:col-span-2 p-4 text-center text-xs text-[#6c7883]">正在拉取上游订阅流量与节点明细...</div>`;
      try {
        const idToken = await user.getIdToken();
        const res = await fetch(api, {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${idToken}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ upstreams: currentSubCfg.upstreams }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.error || `HTTP ${res.status}`);

        const list = Array.isArray(data.upstreams) ? data.upstreams : [];
        if (!list.length) {
          subTelemetryGrid.innerHTML = `<div class="sm:col-span-2 rounded-xl border border-dashed border-slate-200 dark:border-white/10 p-4 text-center text-xs text-[#6c7883]">暂无上游订阅可检测。</div>`;
          return;
        }

        subTelemetryGrid.innerHTML = list
          .map((u: any) => {
            const ui = u.userinfo;
            const used = ui ? (ui.upload || 0) + (ui.download || 0) : 0;
            const total = ui?.total || 0;
            const pct = total > 0 ? Math.min(100, (used / total) * 100) : 0;
            const expireStr =
              ui?.expire > 0 ? new Date(ui.expire * 1000).toLocaleDateString() : '长期 / 未知';
            const names = Array.isArray(u.names) ? u.names : [];
            return `
              <div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 space-y-2 border border-slate-200/60 dark:border-white/5 text-xs">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="w-2 h-2 rounded-full shrink-0 ${u.ok ? 'bg-emerald-500' : 'bg-rose-500'}"></span>
                    <span class="font-semibold text-slate-900 dark:text-[#f5f5f5] truncate">${escapeHtml(u.name)}</span>
                  </div>
                  <span class="text-[11px] text-[#6c7883]">${u.ok ? `${u.nodeCount || 0} 节点` : escapeHtml(u.error || 'Error')}</span>
                </div>

                ${
                  ui
                    ? `
                  <div>
                    <div class="flex justify-between text-[11px] text-[#6c7883] mb-0.5">
                      <span>已用 ${formatBytes(used)}</span>
                      <span>总量 ${total > 0 ? formatBytes(total) : '不限'}</span>
                    </div>
                    <div class="h-1.5 rounded-full bg-slate-200 dark:bg-white/10 overflow-hidden">
                      <div class="h-full bg-[#2481cc] dark:bg-[#3ea6ff]" style="width:${pct}%"></div>
                    </div>
                    <div class="flex justify-between text-[11px] text-[#6c7883] mt-1">
                      <span>↑ ${formatBytes(ui.upload || 0)} · ↓ ${formatBytes(ui.download || 0)}</span>
                      <span>到期 ${expireStr}</span>
                    </div>
                  </div>`
                    : `<div class="text-[11px] text-[#6c7883]">未返回 Subscription-Userinfo 流量头</div>`
                }

                ${
                  names.length
                    ? `<details class="text-[11px] text-[#6c7883]">
                        <summary class="cursor-pointer hover:text-[#2481cc]">查看节点列表 (${names.length})</summary>
                        <ul class="mt-1.5 space-y-0.5 max-h-28 overflow-y-auto pl-2 border-l border-slate-300 dark:border-white/10">
                          ${names.map((n: string) => `<li class="truncate">${escapeHtml(n)}</li>`).join('')}
                        </ul>
                      </details>`
                    : ''
                }
              </div>`;
          })
          .join('');
      } catch (err: any) {
        subTelemetryGrid.innerHTML = `<div class="sm:col-span-2 rounded-xl border border-rose-200 dark:border-rose-500/20 bg-rose-50/60 dark:bg-rose-500/10 p-4 text-xs text-rose-700 dark:text-rose-300">检测失败：${escapeHtml(err?.message || 'Unknown error')}</div>`;
      }
    };
    document.getElementById('sub-refresh-btn')?.addEventListener('click', inspectSubTraffic);

    billingConfigForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = (billingUrlInput?.value || '').trim();
      if (val) {
        localStorage.setItem(BILLING_URL_KEY, val);
        syncSettingsToFirestore({ billingApiUrl: val });
        fetchBillingReport();
      } else {
        localStorage.removeItem(BILLING_URL_KEY);
        syncSettingsToFirestore({ billingApiUrl: '' });
      }
    });
    document.getElementById('billing-refresh-btn')?.addEventListener('click', fetchBillingReport);

    const tabSub = document.getElementById('tool-tab-sub');
    const panelSub = document.getElementById('tool-panel-sub');
    const tabUhd = document.getElementById('tool-tab-uhd');
    const panelUhd = document.getElementById('tool-panel-uhd');

    const setActiveTool = (tool: 'komari' | 'sub' | 'uhd' | 'billing' | 'expense') => {
      const activeCls = 'px-4 py-1.5 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] transition-colors cursor-pointer';
      const inactiveCls = 'px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer';
      if (tabKomari) tabKomari.className = tool === 'komari' ? activeCls : inactiveCls;
      if (tabSub) tabSub.className = tool === 'sub' ? activeCls : inactiveCls;
      if (tabUhd) tabUhd.className = tool === 'uhd' ? activeCls : inactiveCls;
      if (tabBilling) tabBilling.className = tool === 'billing' ? activeCls : inactiveCls;
      if (tabExpense) tabExpense.className = tool === 'expense' ? activeCls : inactiveCls;
      panelKomari?.classList.toggle('hidden', tool !== 'komari');
      panelSub?.classList.toggle('hidden', tool !== 'sub');
      panelUhd?.classList.toggle('hidden', tool !== 'uhd');
      panelBilling?.classList.toggle('hidden', tool !== 'billing');
      panelExpense?.classList.toggle('hidden', tool !== 'expense');
      if (tool === 'billing') {
        fetchBillingReport();
      } else if (tool === 'sub') {
        inspectSubTraffic();
      } else if (tool === 'uhd') {
        fetchUhdStatus();
      }
    };

    tabKomari?.addEventListener('click', () => setActiveTool('komari'));
    tabSub?.addEventListener('click', () => setActiveTool('sub'));
    tabUhd?.addEventListener('click', () => setActiveTool('uhd'));
    tabBilling?.addEventListener('click', () => setActiveTool('billing'));
    tabExpense?.addEventListener('click', () => setActiveTool('expense'));

    const cfg = loadConfig();
    const urlInput = document.getElementById('komari-url') as HTMLInputElement | null;
    const pathInput = document.getElementById('komari-api-path') as HTMLInputElement | null;
    const tokenInput = document.getElementById('komari-token') as HTMLInputElement | null;
    const proxyInput = document.getElementById('komari-proxy-url') as HTMLInputElement | null;
    const modeSelect = document.getElementById('komari-mode') as HTMLSelectElement | null;
    const configForm = document.getElementById('komari-config-form') as HTMLFormElement | null;
    const toggleConfigBtn = document.getElementById('komari-toggle-config-btn');

    if (urlInput) urlInput.value = cfg.baseUrl;
    if (pathInput) pathInput.value = cfg.apiPath;
    if (tokenInput) tokenInput.value = cfg.token;
    if (proxyInput) proxyInput.value = cfg.proxyUrl;
    if (modeSelect) modeSelect.value = cfg.mode;
    if (cfg.baseUrl) {
      configForm?.classList.add('hidden');
    }

    toggleConfigBtn?.addEventListener('click', () => {
      configForm?.classList.toggle('hidden');
    });

    configForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const next: KomariConfig = {
        baseUrl: (urlInput?.value || '').trim().replace(/\/+$/, ''),
        apiPath: (pathInput?.value || '/api/nodes').trim() || '/api/nodes',
        token: (tokenInput?.value || '').trim(),
        proxyUrl: (proxyInput?.value || '').trim(),
        mode: modeSelect?.value === 'iframe' ? 'iframe' : 'api',
      };
      saveConfig(next);
      syncSettingsToFirestore({ komari: next });
      configForm.classList.add('hidden');
      applyKomariMode();
    });

    document.getElementById('komari-refresh-btn')?.addEventListener('click', fetchKomariNodes);
    document.getElementById('komari-auto-refresh')?.addEventListener('change', applyKomariMode);

    googleBtn?.addEventListener('click', async () => {
      try {
        await signInWithGoogle();
      } catch (err: any) {
        if (lockMsg) lockMsg.textContent = err?.message || 'Sign-in failed.';
      }
    });

    logoutBtn?.addEventListener('click', async () => {
      await signOutUser();
    });

    if (!isFirebaseConfigured) {
      if (lockMsg) lockMsg.textContent = 'Firebase is not configured.';
      return;
    }

    unsubscribeAuth?.();
    unsubscribeAuth = onAuthChange((user) => {
      if (!user) {
        if (userLabel) userLabel.textContent = t('tools.notSignedIn');
        googleBtn?.classList.remove('hidden');
        logoutBtn?.classList.add('hidden');
        lockedEl?.classList.remove('hidden');
        workspaceEl?.classList.add('hidden');
        if (lockMsg) lockMsg.textContent = t('tools.lockedDesc');
        if (refreshTimer) {
          clearInterval(refreshTimer);
          refreshTimer = null;
        }
        return;
      }

      if (userLabel) userLabel.textContent = `${user.displayName || 'User'} (${user.email})`;
      googleBtn?.classList.add('hidden');
      logoutBtn?.classList.remove('hidden');

      if (user.email !== ADMIN_EMAIL) {
        lockedEl?.classList.remove('hidden');
        workspaceEl?.classList.add('hidden');
        if (lockMsg) lockMsg.textContent = t('tools.unauthorizedDesc');
        return;
      }

      lockedEl?.classList.add('hidden');
      workspaceEl?.classList.remove('hidden');
      applyKomariMode();
      loadSettingsFromFirestore();
    });
  }

  document.addEventListener('astro:page-load', setupToolboxPage);
  document.addEventListener('astro:before-swap', () => {
    unsubscribeAuth?.();
    unsubscribeAuth = null;
    if (refreshTimer) {
      clearInterval(refreshTimer);
      refreshTimer = null;
    }
  });
</script>
