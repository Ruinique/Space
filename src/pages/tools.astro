---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Toolbox — Ruiyi Zhan (@Ruinique)"
  description="Private personal toolbox for admin"
  subtitle="Personal Toolbox · Private"
>
  <div class="max-w-3xl mx-auto px-4 py-6 space-y-5">
    <!-- Auth Status Card -->
    <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-[#2481cc]/15 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] flex items-center justify-center font-semibold text-sm">
          TB
        </div>
        <div>
          <div data-i18n="tools.title" class="text-sm font-semibold text-slate-900 dark:text-[#f5f5f5]">
            个人工作箱
          </div>
          <div id="tools-user-label" data-i18n="tools.notSignedIn" class="text-xs text-[#6c7883]">
            未登录
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 text-xs">
        <button
          id="tools-google-btn"
          type="button"
          data-i18n="tools.signInGoogle"
          class="px-4 py-2 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium hover:opacity-90 transition-opacity cursor-pointer"
        >
          Google 登录
        </button>
        <button
          id="tools-logout-btn"
          type="button"
          data-i18n="tools.signOut"
          class="hidden px-4 py-2 rounded-full bg-slate-100 dark:bg-white/10 text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          退出登录
        </button>
      </div>
    </div>

    <!-- Locked State -->
    <div id="tools-locked" class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-6 text-center">
      <p id="tools-lock-msg" data-i18n="tools.lockedDesc" class="text-sm text-[#6c7883]">
        工作箱仅对管理员账号 (ruiyizhan2003@gmail.com) 开放，请登录后使用。
      </p>
    </div>

    <!-- Authorized Toolbox Workspace -->
    <div id="tools-workspace" class="hidden space-y-5">
      <!-- Tool Selector Pills -->
      <div class="inline-flex flex-wrap p-1 rounded-full bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] text-xs font-medium gap-1">
        <button
          id="tool-tab-komari"
          type="button"
          class="px-4 py-1.5 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] transition-colors cursor-pointer"
        >
          Komari 探针监控
        </button>
        <button
          id="tool-tab-sub"
          type="button"
          class="px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          订阅分发与流量
        </button>
        <button
          id="tool-tab-uhd"
          type="button"
          class="px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          UHDNOW 媒体库
        </button>
        <button
          id="tool-tab-billing"
          type="button"
          class="px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          GCP 月度账单
        </button>
        <button
          id="tool-tab-expense"
          type="button"
          class="px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          续费账本
        </button>
      </div>

      <!-- Tool 1: Komari Monitor -->
      <section id="tool-panel-komari" class="space-y-4">
        <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5 space-y-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 data-i18n="tools.komariTitle" class="text-base font-semibold text-slate-900 dark:text-[#f5f5f5]">
                Komari 探针监控
              </h2>
              <p data-i18n="tools.komariSubtitle" class="text-xs text-[#6c7883] mt-0.5">
                接入自建 Komari 服务节点状态（REST API / 内嵌面板）
              </p>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <button
                id="komari-toggle-config-btn"
                type="button"
                class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-white/10 text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
              >
                配置
              </button>
              <a
                id="komari-external-link"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="hidden px-3 py-1.5 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:opacity-85 transition-opacity"
              >
                打开面板 ↗
              </a>
            </div>
          </div>

          <!-- Komari Configuration Form -->
          <form id="komari-config-form" class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 space-y-3 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[#6c7883] mb-1" for="komari-url">Komari 实例地址 (URL)</label>
                <input
                  id="komari-url"
                  type="url"
                  placeholder="https://monitor.yourdomain.com"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                />
              </div>
              <div>
                <label class="block text-[#6c7883] mb-1" for="komari-api-path">状态接口路径 (API Path)</label>
                <input
                  id="komari-api-path"
                  type="text"
                  value="/api/nodes"
                  placeholder="/api/nodes"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[#6c7883] mb-1" for="komari-token">API Token（可选，Bearer）</label>
                <input
                  id="komari-token"
                  type="password"
                  placeholder="留空则请求公开状态接口"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                />
              </div>
              <div>
                <label class="block text-[#6c7883] mb-1" for="komari-mode">展示模式</label>
                <select
                  id="komari-mode"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                >
                  <option value="api">API 实时卡片</option>
                  <option value="iframe">内嵌面板 (iframe)</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-[#6c7883] mb-1" for="komari-proxy-url">
                CORS 代理接口 URL（可选，infra/komari-proxy）
              </label>
              <input
                id="komari-proxy-url"
                type="url"
                placeholder="https://us-central1-project-d5956722-3ab5-4c0f-be0.cloudfunctions.net/komariProxy"
                class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
              />
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
              <span class="text-[11px] text-[#6c7883]">
                配置仅保存在当前浏览器 localStorage 中，不会公开上传。
              </span>
              <button
                type="submit"
                class="px-4 py-1.5 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium hover:opacity-90 transition-opacity cursor-pointer"
              >
                保存并连接
              </button>
            </div>
          </form>

          <!-- API Mode Controls & Status -->
          <div id="komari-api-section" class="space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-2">
                <span id="komari-status-badge" class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/10 text-[#6c7883]">
                  未配置实例
                </span>
                <span id="komari-last-updated" class="text-[#6c7883]"></span>
              </div>
              <div class="flex items-center gap-2">
                <label class="inline-flex items-center gap-1.5 text-[#6c7883] cursor-pointer">
                  <input id="komari-auto-refresh" type="checkbox" checked class="accent-[#2481cc]" />
                  <span>10s 自动刷新</span>
                </label>
                <button
                  id="komari-refresh-btn"
                  type="button"
                  class="px-3 py-1 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:opacity-85 transition-opacity cursor-pointer"
                >
                  立即刷新
                </button>
              </div>
            </div>

            <div id="komari-nodes-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="sm:col-span-2 rounded-xl border border-dashed border-slate-200 dark:border-white/10 p-6 text-center text-xs text-[#6c7883]">
                请先在上方填写你的 Komari 实例地址并点击「保存并连接」。
              </div>
            </div>
          </div>

          <!-- Iframe Mode Container -->
          <div id="komari-iframe-section" class="hidden">
            <div class="rounded-xl overflow-hidden border border-slate-200/80 dark:border-white/10 bg-[#f1f4f8] dark:bg-[#0e1621]">
              <iframe
                id="komari-iframe"
                title="Komari Monitor Panel"
                class="w-full h-[560px] border-0"
                loading="lazy"
                referrerpolicy="no-referrer"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <!-- Tool 2: GCP Monthly Billing -->
      <section id="tool-panel-billing" class="hidden space-y-4">
        <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5 space-y-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-base font-semibold text-slate-900 dark:text-[#f5f5f5]">
                GCP 月度账单明细
              </h2>
              <p class="text-xs text-[#6c7883] mt-0.5">
                通过 BigQuery Billing Export + Firebase ID Token 鉴权接口实时查询当月各服务费用
              </p>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <button
                id="billing-refresh-btn"
                type="button"
                class="px-3 py-1.5 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:opacity-85 transition-opacity cursor-pointer"
              >
                刷新账单
              </button>
              <a
                href="https://console.cloud.google.com/billing/reports?project=project-d5956722-3ab5-4c0f-be0"
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-white/10 text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors"
              >
                GCP Console ↗
              </a>
            </div>
          </div>

          <form id="billing-config-form" class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 flex flex-wrap items-end gap-3 text-xs">
            <div class="flex-1 min-w-[220px]">
              <label class="block text-[#6c7883] mb-1" for="billing-api-url">
                Billing Cloud Function URL (infra/billing-api)
              </label>
              <input
                id="billing-api-url"
                type="url"
                placeholder="https://us-central1-project-d5956722-3ab5-4c0f-be0.cloudfunctions.net/getMonthlyBilling"
                class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
              />
            </div>
            <button
              type="submit"
              class="px-4 py-2 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium hover:opacity-90 transition-opacity cursor-pointer"
            >
              保存并查询
            </button>
          </form>

          <div id="billing-summary-grid" class="grid grid-cols-1 sm:grid-cols-3 gap-3 hidden">
            <div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5">
              <div class="text-[11px] text-[#6c7883]">本月折后净费用</div>
              <div id="billing-net-total" class="text-lg font-semibold text-slate-900 dark:text-[#f5f5f5] mt-1">$0.00</div>
            </div>
            <div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5">
              <div class="text-[11px] text-[#6c7883]">原价总计 (Gross)</div>
              <div id="billing-gross-total" class="text-lg font-semibold text-slate-900 dark:text-[#f5f5f5] mt-1">$0.00</div>
            </div>
            <div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5">
              <div class="text-[11px] text-[#6c7883]">免费额度 / 抵扣 (Credits)</div>
              <div id="billing-credits-total" class="text-lg font-semibold text-emerald-600 dark:text-emerald-400 mt-1">$0.00</div>
            </div>
          </div>

          <div id="billing-services-list" class="space-y-2 text-xs text-[#6c7883]">
            <div class="rounded-xl border border-dashed border-slate-200 dark:border-white/10 p-5 text-center">
              请先部署 <code>infra/billing-api</code> 并填入 Cloud Function URL；请求会自动携带你的管理员 Firebase ID Token。
            </div>
          </div>
        </div>
      </section>

      <!-- Tool 3: Lightweight SubHub (Subscription & Traffic Monitor) -->
      <section id="tool-panel-sub" class="hidden space-y-4">
        <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5 space-y-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-base font-semibold text-slate-900 dark:text-[#f5f5f5]">
                订阅分发与流量监控 (SubHub)
              </h2>
              <p class="text-xs text-[#6c7883] mt-0.5">
                轻量替代 Xboard：聚合上游机场/自建订阅、实时解析剩余流量与到期时间，一键下发统一订阅
              </p>
            </div>
            <button
              id="sub-refresh-btn"
              type="button"
              class="px-3 py-1.5 rounded-full text-xs bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:opacity-85 transition-opacity cursor-pointer"
            >
              检测流量与节点
            </button>
          </div>

          <!-- SubHub Endpoint & Token Config -->
          <div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 space-y-3 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[#6c7883] mb-1" for="sub-api-url">
                  SubHub Cloud Function URL (infra/sub-hub)
                </label>
                <input
                  id="sub-api-url"
                  type="url"
                  placeholder="https://us-central1-project-d5956722-3ab5-4c0f-be0.cloudfunctions.net/subHub"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                />
              </div>
              <div>
                <label class="block text-[#6c7883] mb-1" for="sub-token-input">
                  订阅访问密钥 (Sub Token)
                </label>
                <div class="flex gap-1.5">
                  <input
                    id="sub-token-input"
                    type="text"
                    placeholder="用于客户端拉取订阅的密钥"
                    class="flex-1 rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                  />
                  <button
                    id="sub-gen-token-btn"
                    type="button"
                    class="px-2.5 py-2 rounded-lg bg-white dark:bg-[#182533] text-[#6c7883] hover:text-[#2481cc] border border-slate-200/80 dark:border-white/10 cursor-pointer"
                  >
                    随机
                  </button>
                </div>
              </div>
            </div>

            <!-- Dispense Links -->
            <div id="sub-links-box" class="hidden pt-2 border-t border-slate-200/70 dark:border-white/10 space-y-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-[#6c7883]">通用 Base64 订阅（Clash / Shadowrocket / v2rayN）：</span>
                <button
                  id="sub-copy-base64"
                  type="button"
                  class="px-2.5 py-1 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium cursor-pointer"
                >
                  复制 Base64 链接
                </button>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-[#6c7883]">明文节点列表 (Raw URI)：</span>
                <button
                  id="sub-copy-raw"
                  type="button"
                  class="px-2.5 py-1 rounded-full bg-slate-200 dark:bg-white/10 text-slate-700 dark:text-slate-200 font-medium cursor-pointer"
                >
                  复制 Raw 链接
                </button>
              </div>
            </div>
          </div>

          <!-- Upstream Subscriptions Manager -->
          <div class="space-y-2.5 text-xs">
            <div class="font-semibold text-slate-900 dark:text-[#f5f5f5]">上游订阅源</div>
            <div id="sub-upstreams-list" class="space-y-2"></div>

            <div class="flex flex-wrap gap-2 pt-1">
              <input
                id="sub-new-name"
                type="text"
                placeholder="名称（如 JP-A）"
                class="w-32 rounded-lg bg-[#f1f4f8] dark:bg-[#0e1621] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
              />
              <input
                id="sub-new-url"
                type="url"
                placeholder="https://example.com/sub/..."
                class="flex-1 min-w-[200px] rounded-lg bg-[#f1f4f8] dark:bg-[#0e1621] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
              />
              <button
                id="sub-add-upstream-btn"
                type="button"
                class="px-3.5 py-2 rounded-lg bg-slate-100 dark:bg-white/10 text-slate-800 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-white/15 cursor-pointer"
              >
                + 添加
              </button>
            </div>
          </div>

          <!-- Custom Nodes -->
          <div class="space-y-1.5 text-xs">
            <label class="block font-semibold text-slate-900 dark:text-[#f5f5f5]" for="sub-custom-nodes">
              自定义节点（每行一条 vless:// / hy2:// / ss:// 等，可选）
            </label>
            <textarea
              id="sub-custom-nodes"
              rows="3"
              placeholder="vless://..."
              class="w-full rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3 font-mono text-[11px] text-slate-900 dark:text-[#f5f5f5] placeholder:text-[#6c7883] focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
            ></textarea>
          </div>

          <div class="flex items-center justify-between gap-2 text-xs">
            <span id="sub-save-status" class="text-[#6c7883]">配置加密同步至私有 Firestore，不进入公开仓库。</span>
            <button
              id="sub-save-btn"
              type="button"
              class="px-4 py-2 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium hover:opacity-90 transition-opacity cursor-pointer"
            >
              保存全部订阅配置
            </button>
          </div>

          <!-- Traffic & Node Telemetry Cards -->
          <div id="sub-telemetry-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2"></div>
        </div>
      </section>

      <!-- Tool 4: UHDNOW Independent Tool (API Status + Remaining Days + Emby Lines) -->
      <section id="tool-panel-uhd" class="hidden space-y-4">
        <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5 space-y-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-base font-semibold text-slate-900 dark:text-[#f5f5f5]">
                UHDNOW · 4K Emby 媒体库
              </h2>
              <p class="text-xs text-[#6c7883] mt-0.5">
                通过 API 查询账号剩余天数 / 流量 / Emby 在线状态与全部可用线路（配置跨设备同步）
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <a
                href="https://www.uhdnow.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-1.5 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium hover:opacity-90 transition-opacity"
              >
                官网 ↗
              </a>
