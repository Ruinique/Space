---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Toolbox — Ruiyi Zhan (@Ruinique)"
  description="Private personal toolbox for admin"
  subtitle="Personal Toolbox · Private"
>
  <div class="max-w-3xl mx-auto px-4 py-6 space-y-5">
    <!-- Auth Status Card -->
    <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-[#2481cc]/15 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] flex items-center justify-center font-semibold text-sm">
          TB
        </div>
        <div>
          <div data-i18n="tools.title" class="text-sm font-semibold text-slate-900 dark:text-[#f5f5f5]">
            个人工作箱
          </div>
          <div id="tools-user-label" data-i18n="tools.notSignedIn" class="text-xs text-[#6c7883]">
            未登录
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 text-xs">
        <button
          id="tools-google-btn"
          type="button"
          data-i18n="tools.signInGoogle"
          class="px-4 py-2 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium hover:opacity-90 transition-opacity cursor-pointer"
        >
          Google 登录
        </button>
        <button
          id="tools-logout-btn"
          type="button"
          data-i18n="tools.signOut"
          class="hidden px-4 py-2 rounded-full bg-slate-100 dark:bg-white/10 text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          退出登录
        </button>
      </div>
    </div>

    <!-- Locked State -->
    <div id="tools-locked" class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-6 text-center">
      <p id="tools-lock-msg" data-i18n="tools.lockedDesc" class="text-sm text-[#6c7883]">
        工作箱仅对管理员账号 (ruiyizhan2003@gmail.com) 开放，请登录后使用。
      </p>
    </div>

    <!-- Authorized Toolbox Workspace -->
    <div id="tools-workspace" class="hidden space-y-5">
      <!-- Tool Selector Pills -->
      <div class="inline-flex flex-wrap p-1 rounded-full bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] text-xs font-medium gap-1">
        <button
          id="tool-tab-komari"
          type="button"
          class="px-4 py-1.5 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] transition-colors cursor-pointer"
        >
          Komari 探针监控
        </button>
        <button
          id="tool-tab-expense"
          type="button"
          class="px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          记账助手 (Soon)
        </button>
      </div>

      <!-- Tool 1: Komari Monitor -->
      <section id="tool-panel-komari" class="space-y-4">
        <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-4 sm:p-5 space-y-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 data-i18n="tools.komariTitle" class="text-base font-semibold text-slate-900 dark:text-[#f5f5f5]">
                Komari 探针监控
              </h2>
              <p data-i18n="tools.komariSubtitle" class="text-xs text-[#6c7883] mt-0.5">
                接入自建 Komari 服务节点状态（REST API / 内嵌面板）
              </p>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <button
                id="komari-toggle-config-btn"
                type="button"
                class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-white/10 text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
              >
                配置
              </button>
              <a
                id="komari-external-link"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="hidden px-3 py-1.5 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:opacity-85 transition-opacity"
              >
                打开面板 ↗
              </a>
            </div>
          </div>

          <!-- Komari Configuration Form -->
          <form id="komari-config-form" class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 space-y-3 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[#6c7883] mb-1" for="komari-url">Komari 实例地址 (URL)</label>
                <input
                  id="komari-url"
                  type="url"
                  placeholder="https://monitor.yourdomain.com"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                />
              </div>
              <div>
                <label class="block text-[#6c7883] mb-1" for="komari-api-path">状态接口路径 (API Path)</label>
                <input
                  id="komari-api-path"
                  type="text"
                  value="/api/nodes"
                  placeholder="/api/nodes"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-[#6c7883] mb-1" for="komari-token">API Token（可选，Bearer）</label>
                <input
                  id="komari-token"
                  type="password"
                  placeholder="留空则请求公开状态接口"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                />
              </div>
              <div>
                <label class="block text-[#6c7883] mb-1" for="komari-mode">展示模式</label>
                <select
                  id="komari-mode"
                  class="w-full rounded-lg bg-white dark:bg-[#182533] px-3 py-2 text-slate-900 dark:text-[#f5f5f5] border border-slate-200/80 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-[#2481cc]/40"
                >
                  <option value="api">API 实时卡片</option>
                  <option value="iframe">内嵌面板 (iframe)</option>
                </select>
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
              <span class="text-[11px] text-[#6c7883]">
                配置仅保存在当前浏览器 localStorage 中，不会公开上传。
              </span>
              <button
                type="submit"
                class="px-4 py-1.5 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] font-medium hover:opacity-90 transition-opacity cursor-pointer"
              >
                保存并连接
              </button>
            </div>
          </form>

          <!-- API Mode Controls & Status -->
          <div id="komari-api-section" class="space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-2">
                <span id="komari-status-badge" class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/10 text-[#6c7883]">
                  未配置实例
                </span>
                <span id="komari-last-updated" class="text-[#6c7883]"></span>
              </div>
              <div class="flex items-center gap-2">
                <label class="inline-flex items-center gap-1.5 text-[#6c7883] cursor-pointer">
                  <input id="komari-auto-refresh" type="checkbox" checked class="accent-[#2481cc]" />
                  <span>10s 自动刷新</span>
                </label>
                <button
                  id="komari-refresh-btn"
                  type="button"
                  class="px-3 py-1 rounded-full bg-[#2481cc]/10 text-[#2481cc] dark:bg-[#3ea6ff]/15 dark:text-[#3ea6ff] hover:opacity-85 transition-opacity cursor-pointer"
                >
                  立即刷新
                </button>
              </div>
            </div>

            <div id="komari-nodes-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="sm:col-span-2 rounded-xl border border-dashed border-slate-200 dark:border-white/10 p-6 text-center text-xs text-[#6c7883]">
                请先在上方填写你的 Komari 实例地址并点击「保存并连接」。
              </div>
            </div>
          </div>

          <!-- Iframe Mode Container -->
          <div id="komari-iframe-section" class="hidden">
            <div class="rounded-xl overflow-hidden border border-slate-200/80 dark:border-white/10 bg-[#f1f4f8] dark:bg-[#0e1621]">
              <iframe
                id="komari-iframe"
                title="Komari Monitor Panel"
                class="w-full h-[560px] border-0"
                loading="lazy"
                referrerpolicy="no-referrer"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <!-- Tool 2: Reserved Slot for Expense Tracker -->
      <section id="tool-panel-expense" class="hidden">
        <div class="rounded-2xl bg-white dark:bg-[#182533] shadow-[0_1px_2px_rgba(0,0,0,0.06)] p-6 space-y-3">
          <div class="flex items-center gap-2.5">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/15 text-amber-600 dark:text-amber-400">
              Planned
            </span>
            <h2 data-i18n="tools.expenseTitle" class="text-base font-semibold text-slate-900 dark:text-[#f5f5f5]">
              记账助手（即将上线）
            </h2>
          </div>
          <p data-i18n="tools.expenseDesc" class="text-sm text-[#6c7883] leading-relaxed">
            预留工具位：后续可接入 Firestore 私人账本，支持快速记账、月度统计与分类预算。
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    ADMIN_EMAIL,
    isFirebaseConfigured,
    onAuthChange,
    signInWithGoogle,
    signOutUser,
  } from '../lib/firebase';
  import { applyI18n, t } from '../lib/i18n';

  interface KomariConfig {
    baseUrl: string;
    apiPath: string;
    token: string;
    mode: 'api' | 'iframe';
  }

  const STORAGE_KEY = 'space_komari_config_v1';
  let unsubscribeAuth: (() => void) | null = null;
  let refreshTimer: ReturnType<typeof setInterval> | null = null;

  function escapeHtml(str: unknown): string {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function loadConfig(): KomariConfig {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        return {
          baseUrl: typeof parsed.baseUrl === 'string' ? parsed.baseUrl : '',
          apiPath: typeof parsed.apiPath === 'string' && parsed.apiPath ? parsed.apiPath : '/api/nodes',
          token: typeof parsed.token === 'string' ? parsed.token : '',
          mode: parsed.mode === 'iframe' ? 'iframe' : 'api',
        };
      }
    } catch {
      // ignore invalid storage
    }
    return { baseUrl: '', apiPath: '/api/nodes', token: '', mode: 'api' };
  }

  function saveConfig(cfg: KomariConfig): void {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg));
  }

  function formatBytes(bytes: number): string {
    if (!Number.isFinite(bytes) || bytes <= 0) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
    return `${(bytes / Math.pow(1024, i)).toFixed(1)} ${units[i]}`;
  }

  function formatUptime(sec: number): string {
    if (!Number.isFinite(sec) || sec <= 0) return '-';
    const d = Math.floor(sec / 86400);
    const h = Math.floor((sec % 86400) / 3600);
    const m = Math.floor((sec % 3600) / 60);
    if (d > 0) return `${d}d ${h}h`;
    if (h > 0) return `${h}h ${m}m`;
    return `${m}m`;
  }

  function normalizeNodes(payload: any): any[] {
    if (Array.isArray(payload)) return payload;
    if (payload && Array.isArray(payload.data)) return payload.data;
    if (payload && payload.data && Array.isArray(payload.data.nodes)) return payload.data.nodes;
    if (payload && Array.isArray(payload.nodes)) return payload.nodes;
    return [];
  }

  function renderNodes(nodes: any[]) {
    const grid = document.getElementById('komari-nodes-grid');
    if (!grid) return;

    if (!nodes.length) {
      grid.innerHTML = `
        <div class="sm:col-span-2 rounded-xl border border-dashed border-slate-200 dark:border-white/10 p-6 text-center text-xs text-[#6c7883]">
          接口返回成功，但暂无节点数据。
        </div>`;
      return;
    }

    grid.innerHTML = nodes
      .map((n) => {
        const name = escapeHtml(n.name || n.hostname || n.uuid || 'Unnamed Node');
        const region = escapeHtml(n.region || n.country || n.os || '');
        const online =
          typeof n.online === 'boolean'
            ? n.online
            : typeof n.status === 'string'
              ? n.status.toLowerCase() === 'online'
              : true;

        const cpu = Number(n.cpu_usage ?? n.cpu?.usage ?? n.cpu ?? 0);
        const memUsed = Number(n.mem_used ?? n.ram?.used ?? 0);
        const memTotal = Number(n.mem_total ?? n.ram?.total ?? 0);
        const memPct = memTotal > 0 ? Math.min(100, (memUsed / memTotal) * 100) : Number(n.mem_usage ?? 0);
        const diskUsed = Number(n.disk_used ?? n.disk?.used ?? 0);
        const diskTotal = Number(n.disk_total ?? n.disk?.total ?? 0);
        const diskPct = diskTotal > 0 ? Math.min(100, (diskUsed / diskTotal) * 100) : Number(n.disk_usage ?? 0);
        const netUp = Number(n.net_out ?? n.network?.up ?? n.up ?? 0);
        const netDown = Number(n.net_in ?? n.network?.down ?? n.down ?? 0);
        const uptime = Number(n.uptime ?? 0);

        return `
          <div class="rounded-xl bg-[#f1f4f8] dark:bg-[#0e1621] p-3.5 space-y-2.5 border border-slate-200/60 dark:border-white/5">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-2 h-2 rounded-full shrink-0 ${online ? 'bg-emerald-500' : 'bg-rose-500'}"></span>
                <span class="text-sm font-semibold text-slate-900 dark:text-[#f5f5f5] truncate">${name}</span>
              </div>
              <span class="text-[11px] text-[#6c7883] shrink-0">${region || (online ? 'Online' : 'Offline')}</span>
            </div>

            <div class="space-y-1.5 text-[11px]">
              <div>
                <div class="flex justify-between text-[#6c7883] mb-0.5">
                  <span>CPU</span><span>${Number.isFinite(cpu) ? cpu.toFixed(1) : '0.0'}%</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-200 dark:bg-white/10 overflow-hidden">
                  <div class="h-full bg-[#2481cc] dark:bg-[#3ea6ff]" style="width:${Math.min(100, Math.max(0, cpu))}%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-[#6c7883] mb-0.5">
                  <span>RAM</span>
                  <span>${memTotal > 0 ? `${formatBytes(memUsed)} / ${formatBytes(memTotal)}` : `${memPct.toFixed(1)}%`}</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-200 dark:bg-white/10 overflow-hidden">
                  <div class="h-full bg-emerald-500" style="width:${Math.min(100, Math.max(0, memPct))}%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-[#6c7883] mb-0.5">
                  <span>Disk</span>
                  <span>${diskTotal > 0 ? `${formatBytes(diskUsed)} / ${formatBytes(diskTotal)}` : `${diskPct.toFixed(1)}%`}</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-200 dark:bg-white/10 overflow-hidden">
                  <div class="h-full bg-violet-500" style="width:${Math.min(100, Math.max(0, diskPct))}%"></div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between text-[11px] text-[#6c7883] pt-1 border-t border-slate-200/70 dark:border-white/5">
              <span>↑ ${formatBytes(netUp)}/s · ↓ ${formatBytes(netDown)}/s</span>
              <span>Up ${formatUptime(uptime)}</span>
            </div>
          </div>
        `;
      })
      .join('');
  }

  async function fetchKomariNodes() {
    const cfg = loadConfig();
    const badge = document.getElementById('komari-status-badge');
    const updatedEl = document.getElementById('komari-last-updated');
    const grid = document.getElementById('komari-nodes-grid');

    if (!cfg.baseUrl) {
      if (badge) badge.textContent = '未配置实例';
      return;
    }

    const cleanBase = cfg.baseUrl.replace(/\/+$/, '');
    const cleanPath = cfg.apiPath.startsWith('/') ? cfg.apiPath : `/${cfg.apiPath}`;
    const endpoint = `${cleanBase}${cleanPath}`;

    if (badge) {
      badge.textContent = '● 同步中...';
      badge.className = 'px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400';
    }

    try {
      const headers: Record<string, string> = {};
      if (cfg.token.trim()) {
        headers['Authorization'] = `Bearer ${cfg.token.trim()}`;
      }
      const res = await fetch(endpoint, { headers });
      if (!res.ok) {
        throw new Error(`HTTP ${res.status} ${res.statusText}`);
      }
      const data = await res.json();
      const nodes = normalizeNodes(data);
      renderNodes(nodes);

      if (badge) {
        badge.textContent = `● 在线 (${nodes.length})`;
        badge.className = 'px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400';
      }
      if (updatedEl) {
        updatedEl.textContent = `更新于 ${new Date().toLocaleTimeString()}`;
      }
    } catch (err: any) {
      if (badge) {
        badge.textContent = '● 连接失败';
        badge.className = 'px-2.5 py-1 rounded-full bg-rose-500/15 text-rose-600 dark:text-rose-400';
      }
      if (grid) {
        grid.innerHTML = `
          <div class="sm:col-span-2 rounded-xl border border-rose-200 dark:border-rose-500/20 bg-rose-50/60 dark:bg-rose-500/10 p-4 text-xs text-rose-700 dark:text-rose-300 space-y-1.5">
            <div class="font-semibold">无法从浏览器请求 ${escapeHtml(endpoint)}</div>
            <div>错误：${escapeHtml(err?.message || 'Network / CORS error')}</div>
            <div class="text-[#6c7883] dark:text-slate-300">
              提示：由于本站是纯静态页面，若 Komari 后端未开启 CORS（<code>Access-Control-Allow-Origin</code>），浏览器会拦截跨域请求。你可以在反代（Nginx / Caddy / Cloudflare）添加 CORS 响应头，或将上方「展示模式」切换为「内嵌面板 (iframe)」。
            </div>
          </div>`;
      }
    }
  }

  function applyKomariMode() {
    const cfg = loadConfig();
    const apiSection = document.getElementById('komari-api-section');
    const iframeSection = document.getElementById('komari-iframe-section');
    const iframe = document.getElementById('komari-iframe') as HTMLIFrameElement | null;
    const extLink = document.getElementById('komari-external-link') as HTMLAnchorElement | null;

    if (extLink) {
      if (cfg.baseUrl) {
        extLink.href = cfg.baseUrl;
        extLink.classList.remove('hidden');
      } else {
        extLink.classList.add('hidden');
      }
    }

    if (refreshTimer) {
      clearInterval(refreshTimer);
      refreshTimer = null;
    }

    if (cfg.mode === 'iframe') {
      apiSection?.classList.add('hidden');
      iframeSection?.classList.remove('hidden');
      if (iframe && cfg.baseUrl) {
        iframe.src = cfg.baseUrl;
      }
    } else {
      iframeSection?.classList.add('hidden');
      apiSection?.classList.remove('hidden');
      if (cfg.baseUrl) {
        fetchKomariNodes();
        const autoBox = document.getElementById('komari-auto-refresh') as HTMLInputElement | null;
        if (autoBox?.checked) {
          refreshTimer = setInterval(fetchKomariNodes, 10000);
        }
      }
    }
  }

  function setupToolboxPage() {
    applyI18n();

    const googleBtn = document.getElementById('tools-google-btn') as HTMLButtonElement | null;
    const logoutBtn = document.getElementById('tools-logout-btn') as HTMLButtonElement | null;
    const userLabel = document.getElementById('tools-user-label');
    const lockedEl = document.getElementById('tools-locked');
    const lockMsg = document.getElementById('tools-lock-msg');
    const workspaceEl = document.getElementById('tools-workspace');

    const tabKomari = document.getElementById('tool-tab-komari');
    const tabExpense = document.getElementById('tool-tab-expense');
    const panelKomari = document.getElementById('tool-panel-komari');
    const panelExpense = document.getElementById('tool-panel-expense');

    const setActiveTool = (tool: 'komari' | 'expense') => {
      const activeCls = 'px-4 py-1.5 rounded-full bg-[#2481cc] dark:bg-[#3ea6ff] text-white dark:text-[#0e1621] transition-colors cursor-pointer';
      const inactiveCls = 'px-4 py-1.5 rounded-full text-[#6c7883] hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer';
      if (tabKomari) tabKomari.className = tool === 'komari' ? activeCls : inactiveCls;
      if (tabExpense) tabExpense.className = tool === 'expense' ? activeCls : inactiveCls;
      panelKomari?.classList.toggle('hidden', tool !== 'komari');
      panelExpense?.classList.toggle('hidden', tool !== 'expense');
    };

    tabKomari?.addEventListener('click', () => setActiveTool('komari'));
    tabExpense?.addEventListener('click', () => setActiveTool('expense'));

    const cfg = loadConfig();
    const urlInput = document.getElementById('komari-url') as HTMLInputElement | null;
    const pathInput = document.getElementById('komari-api-path') as HTMLInputElement | null;
    const tokenInput = document.getElementById('komari-token') as HTMLInputElement | null;
    const modeSelect = document.getElementById('komari-mode') as HTMLSelectElement | null;
    const configForm = document.getElementById('komari-config-form') as HTMLFormElement | null;
    const toggleConfigBtn = document.getElementById('komari-toggle-config-btn');

    if (urlInput) urlInput.value = cfg.baseUrl;
    if (pathInput) pathInput.value = cfg.apiPath;
    if (tokenInput) tokenInput.value = cfg.token;
    if (modeSelect) modeSelect.value = cfg.mode;
    if (cfg.baseUrl) {
      configForm?.classList.add('hidden');
    }

    toggleConfigBtn?.addEventListener('click', () => {
      configForm?.classList.toggle('hidden');
    });

    configForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const next: KomariConfig = {
        baseUrl: (urlInput?.value || '').trim().replace(/\/+$/, ''),
        apiPath: (pathInput?.value || '/api/nodes').trim() || '/api/nodes',
        token: (tokenInput?.value || '').trim(),
        mode: modeSelect?.value === 'iframe' ? 'iframe' : 'api',
      };
      saveConfig(next);
      configForm.classList.add('hidden');
      applyKomariMode();
    });

    document.getElementById('komari-refresh-btn')?.addEventListener('click', fetchKomariNodes);
    document.getElementById('komari-auto-refresh')?.addEventListener('change', applyKomariMode);

    googleBtn?.addEventListener('click', async () => {
      try {
        await signInWithGoogle();
      } catch (err: any) {
        if (lockMsg) lockMsg.textContent = err?.message || 'Sign-in failed.';
      }
    });

    logoutBtn?.addEventListener('click', async () => {
      await signOutUser();
    });

    if (!isFirebaseConfigured) {
      if (lockMsg) lockMsg.textContent = 'Firebase is not configured.';
      return;
    }

    unsubscribeAuth?.();
    unsubscribeAuth = onAuthChange((user) => {
      if (!user) {
        if (userLabel) userLabel.textContent = t('tools.notSignedIn');
        googleBtn?.classList.remove('hidden');
        logoutBtn?.classList.add('hidden');
        lockedEl?.classList.remove('hidden');
        workspaceEl?.classList.add('hidden');
        if (lockMsg) lockMsg.textContent = t('tools.lockedDesc');
        if (refreshTimer) {
          clearInterval(refreshTimer);
          refreshTimer = null;
        }
        return;
      }

      if (userLabel) userLabel.textContent = `${user.displayName || 'User'} (${user.email})`;
      googleBtn?.classList.add('hidden');
      logoutBtn?.classList.remove('hidden');

      if (user.email !== ADMIN_EMAIL) {
        lockedEl?.classList.remove('hidden');
        workspaceEl?.classList.add('hidden');
        if (lockMsg) lockMsg.textContent = t('tools.unauthorizedDesc');
        return;
      }

      lockedEl?.classList.add('hidden');
      workspaceEl?.classList.remove('hidden');
      applyKomariMode();
    });
  }

  document.addEventListener('astro:page-load', setupToolboxPage);
  document.addEventListener('astro:before-swap', () => {
    unsubscribeAuth?.();
    unsubscribeAuth = null;
    if (refreshTimer) {
      clearInterval(refreshTimer);
      refreshTimer = null;
    }
  });
</script>
